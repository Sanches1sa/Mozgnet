  "ask": [
   "откати облако",
   "верни прошлую версию облака",
   "откат обновления"
  ],
  "target": "cloud",
  "risk": "danger",
  "steps": [
   {
    "tool": "cloud",
    "op": "update_status"
   },
   {
    "tool": "note",
    "text": "Выбери имя копии из списка (например pre-3.218.0-…) и повтори задачу: «откати облако на копию <имя>»."
   },
   {
    "tool": "cloud",
    "op": "rollback",
    "backup": "{backup}"
   }
  ],
  "slots": {
   "backup": "(?:копи\\w+|backup)\\s+(pre-[\\w.\\-]+)"
  },
  "verify": [
   "облако перезапустится на выбранной версии"
  ],
  "rollback": "повторный откат/обновление на нужную версию",
  "notes": "Данные (data/) не откатываются — меняется только код.",
  "verified": false
