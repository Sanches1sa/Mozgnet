  ],
  "target": "board",
  "risk": "read",
  "steps": [
   {
    "tool": "check"
   },
   {
    "tool": "note",
    "text": "1) Проверь питание (кабель, блок питания не слабее 5 В / 3 А). 2) Посмотри индикаторы на плате. 3) Проверь Wi-Fi/кабель и IP платы в роутере. 4) Если пинга нет: отключи питание на 10 секунд и включи. 5) Подожди 2–3 минуты (первая загрузка медленнее) и повтори проверку."
   }
  ],
  "verify": [
   "понятно, что делать владельцу: питание, сеть, перезапуск по питанию"
  ],
  "notes": "Дистанционно плату без сети не перезагрузить — только питанием.",
  "verified": false
 },
