 {
  "id": "bd.autostart.install",
  "title": "Установить автозапуск neuro_12 (служба neuro12 + сторож)",
  "ask": [
   "установи автозапуск на плате",
   "сделай автозапуск приложения",
   "чтобы после перезагрузки приложение стартовало",
   "установи сторож neuro12"
  ],
  "target": "board",
  "risk": "change",
  "steps": [
   {
    "tool": "run",
    "command": "ls ~/ArduinoApps/neuro_12/deploy_cli/install_autostart.sh 2>&1",
    "note": "скрипт должен лежать в приложении",
    "stop_on_fail": true
   },
   {
    "tool": "run",
    "command": "sudo -n bash ~/ArduinoApps/neuro_12/deploy_cli/install_autostart.sh watchdog 2>&1 | tail -15",
    "note": "нужен sudo без пароля"
   },
   {
    "tool": "run",
    "command": "systemctl is-enabled neuro12 2>&1; systemctl is-active neuro12 2>&1"
   }
  ],
  "verify": [
   "служба neuro12 включена"
  ],
  "rollback": "sudo systemctl disable --now neuro12",
  "notes": "Скрипт и поведение описаны в README платы (deploy_cli). Нужен интернет не обязательно.",
  "verified": false
 },
