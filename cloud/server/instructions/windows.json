   "перезагрузи компьютер",
   "рестарт windows"
  ],
  "target": "windows",
  "risk": "danger",
  "steps": [
   {
    "tool": "run",
    "command": "query user 2>&1",
    "note": "кто вошёл"
   },
   {
    "tool": "run",
