[
 {
  "id": "wn.overview",
  "title": "Общий обзор Windows",
  "ask": [
   "проверь компьютер",
   "обзор windows",
   "состояние компьютера",
   "как дела на windows",
   "проверь сервер windows"
  ],
  "target": "windows",
  "risk": "read",
  "steps": [
   {
    "tool": "run",
    "command": "Get-CimInstance Win32_OperatingSystem | Select-Object Caption,Version,CSName,LastBootUpTime | Format-List"
   },
   {
    "tool": "run",
    "command": "Get-PSDrive -PSProvider FileSystem | Select-Object Name,@{n='ИспГБ';e={[math]::Round($_.Used/1GB,1)}},@{n='СвобГБ';e={[math]::Round($_.Free/1GB,1)}}"
   },
   {
    "tool": "run",
    "command": "Get-Service | Where-Object {$_.Status -eq 'Stopped' -and $_.StartType -eq 'Automatic'} | Select-Object -First 15 Name,DisplayName"
   }
  ],
  "verified": false
 },
