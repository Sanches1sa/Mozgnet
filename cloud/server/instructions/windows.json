 {
  "id": "wn.svc.restart",
  "title": "Перезапустить службу Windows",
  "ask": [
   "перезапусти службу windows",
   "рестарт службы windows"
  ],
  "target": "windows",
  "risk": "change",
  "steps": [
   {
    "tool": "run",
    "command": "Get-Service -Name {service} | Select-Object Name,Status",
    "stop_on_fail": true
   },
   {
    "tool": "run",
    "command": "Restart-Service -Name {service} -ErrorAction Stop"
   },
   {
    "tool": "wait",
    "seconds": 5
   },
   {
    "tool": "run",
    "command": "Get-Service -Name {service} | Select-Object Name,Status",
    "expect": "Running"
   }
  ],
  "slots": {
   "service": "(?:служб\\w*|сервис\\w*|service)\\s+([\\w.\\-]+)"
  },
  "verify": [
   "Status Running"
  ],
  "verified": false
 },
