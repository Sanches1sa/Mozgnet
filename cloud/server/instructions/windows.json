 {
  "id": "wn.proc.kill",
  "title": "Завершить процесс",
  "ask": [
   "заверши процесс windows",
   "убей процесс windows",
   "закрой процесс"
  ],
  "target": "windows",
  "risk": "change",
  "steps": [
   {
    "tool": "run",
    "command": "Get-Process -Name {proc} -ErrorAction SilentlyContinue | Select-Object Name,Id,StartTime",
    "stop_on_fail": true
   },
   {
    "tool": "run",
    "command": "Stop-Process -Name {proc} -ErrorAction Stop"
   },
   {
    "tool": "wait",
    "seconds": 2
   },
   {
    "tool": "run",
    "command": "Get-Process -Name {proc} -ErrorAction SilentlyContinue | Select-Object Name,Id"
   }
  ],
  "slots": {
   "proc": "(?:процесс\\w*|process)\\s+([\\w.\\-]+)"
  },
  "rollback": "запустить программу заново",
  "verified": false
 },
 {
