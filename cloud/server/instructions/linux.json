 {
  "id": "lx.proc.kill",
  "title": "Завершить процесс по PID",
  "ask": [
   "убей процесс",
   "заверши процесс",
   "kill процесс"
  ],
  "target": "linux",
  "risk": "change",
  "steps": [
   {
    "tool": "run",
    "command": "ps -p {pid} -o pid,etime,cmd 2>&1",
    "note": "сначала убедись, что это тот процесс",
    "stop_on_fail": true
   },
   {
    "tool": "run",
    "command": "kill {pid} 2>&1"
   },
   {
    "tool": "wait",
    "seconds": 3
   },
   {
    "tool": "run",
    "command": "ps -p {pid} 2>&1 || echo 'завершён'"
   }
  ],
  "slots": {
   "pid": "(?:pid|процесс\\w*)\\s+(\\d{1,7})"
  },
  "rollback": "процесс не вернуть; если служба — systemctl start",
  "notes": "kill шлёт SIGTERM. kill -9 — только если не завершился, и после отдельного вопроса владельцу.",
  "verified": false
 },
 {
  "id": "lx.zombie",
