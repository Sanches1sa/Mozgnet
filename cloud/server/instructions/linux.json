   },
   {
    "tool": "run",
    "command": "test -f /var/run/reboot-required && echo 'нужна' || echo 'не требуется'"
   },
   {
    "tool": "run",
    "command": "sudo -n systemctl reboot 2>&1",
    "note": "связь оборвётся"
   },
   {
    "tool": "wait",
    "seconds": 60
   },
   {
    "tool": "check"
   },
   {
    "tool": "wait",
    "seconds": 30
   },
   {
    "tool": "check"
   },
   {
    "tool": "run",
    "command": "uptime -p; systemctl --failed --no-pager | head -8"
   }
  ],
  "verify": [
   "сервер вернулся, нет упавших служб"
  ],
  "rollback": "если не поднялся — консоль/IPMI/питание",
