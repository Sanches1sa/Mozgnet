/* v2.14: РЕЧЬ МОЗГА НА D8 (say_wave). Python разбирает WAV облака на
 * огибающую «частота:длительность;» — строки кадров «hz:ms;» — и шлёт сюда.
 * Проигрываем через существующий неблокирующий движок мелодий mel[]
 * (melTick в loop): каждый кадр = нота hz на ms, пауза = hz 0.
 * Речь мозга перебивает и мелодию слова, и мотивационные посылки.       */
String rpcSayWave(String frames) {
  if (!voiceOn) return String("voice_off");
  int16_t hz[MEL_MAX];
  uint16_t ms[MEL_MAX];
  uint8_t n = 0;
  int p = 0;
  int L = frames.length();
  while (p < L && n < MEL_MAX) {
    int colon = frames.indexOf(':', p);
    if (colon < 0) break;
    int semi = frames.indexOf(';', colon);
    if (semi < 0) semi = L;
    long f = frames.substring(p, colon).toInt();
    long d = frames.substring(colon + 1, semi).toInt();
    p = semi + 1;
    if (d <= 0) continue;
    if (f < 0) f = 0;
    if (f > 1200) f = 1200;
    if (d > 400) d = 400;
    hz[n] = (int16_t)f;
    ms[n] = (uint16_t)d;
    n++;
  }
  if (!n) return String("empty");
  voxSteps = 0;                       /* речь важнее «мотивации» и слова  */
  melIdx = 0;
  melLen = n;
  melTone = true;
  tMel = millis();
  for (uint8_t i = 0; i < n; i++) { mel[i].hz = (uint16_t)hz[i]; mel[i].ms = ms[i]; }
  if (mel[0].hz) toneHz = mel[0].hz;
  nextToneEdgeUs = micros();
  voiceWave++;                        /* статистика: сколько «речей»      */
  return String("ok:") + n;
}

/* v2.14: пульс моста — Python сам проверяет, жив ли скетч (когда on_state
 * молчат). Отвечаем мгновенно: аптайм в секундах.                       */
String rpcPing() { return String(millis() / 1000UL); }

/* v2.67: "гц,сила%" — общий ритм платформы (см. syncHz). Мгновенно. */
void rpcSyncHz(String v) {
  int c = v.indexOf(',');
  long hz = (c >= 0 ? v.substring(0, c) : v).toInt();
  long k = c >= 0 ? v.substring(c + 1).toInt() : 30;
  if (hz < 0) hz = 0;
  if (hz > 4000) hz = 4000;
  if (k < 0) k = 0;
  if (k > 60) k = 60;
  syncHz = (uint16_t)hz;
  syncK = (uint8_t)k;
  syncTs = millis();
}

/* v2.22: фраза мозга -> БУФЕР СЛОВ на D6. Python по-прежнему шлёт номера
 * букв через запятую ("4,1,33,0,15", 0 = пробел/знак; main.py не менялся).
 * Скетч декодирует их в ТЕКСТОВЫЙ буфер: 1..33 -> буква RU33, 0 -> пробел —
 * получается буфер, в котором СЛОВА. На D6 (d6Tick в loop) уходят БАЙТЫ
 * этого буфера, а не номера. Обработчик мгновенный — только заполняет
 * буфер.                                                               */
void rpcD6Seq(String seq) {
  char txt[D6_TXT_MAX + 1];
  uint16_t n = 0;
  long v = 0;
  bool have = false;
  for (unsigned i = 0; i <= seq.length(); i++) {
    char c = (i < seq.length()) ? seq.charAt(i) : ',';  // хвост — разделитель
    if (c >= '0' && c <= '9') {
      v = v * 10 + (c - '0');
      if (v > 99) v = 99;
      have = true;
    } else if (have) {
      uint8_t num = (uint8_t)constrain(v, 0, 33);
      if (num == 0) {                    // пробел/знак -> разделитель слов
        if (n && n < D6_TXT_MAX && txt[n - 1] != ' ') txt[n++] = ' ';
      } else if (n + 2 <= D6_TXT_MAX) {  // буква 1..33 -> 2 байта UTF-8
        txt[n++] = RU33[num - 1][0];
        txt[n++] = RU33[num - 1][1];
      }
      v = 0; have = false;
    }
    if (c != ',' && (c < '0' || c > '9')) break;
  }
  while (n && txt[n - 1] == ' ') n--;    // хвостовые пробелы — долой
  txt[n] = 0;
  if (n) d6PutText(txt);                 // начать немедленно
}

/* v2.46: знаковая частота на D6: "-37" / "120" -> кадр после текста. */
void rpcParticleCfg(String v) {
  /* формат: "grav:1,muon:0,phot:1,gen:800,cpu:1,min:100,max:4.0" */
  partGrav = v.indexOf("grav:1") >= 0;
  partMuon = v.indexOf("muon:1") >= 0;
  partPhot = v.indexOf("phot:1") >= 0;
  int g = v.indexOf("gen:");
  if (g >= 0) genFreqOverride = (uint16_t)v.substring(g + 4).toInt();
  cpuFreqLink = v.indexOf("cpu:1") >= 0;
  int mn = v.indexOf("min:");
  if (mn >= 0) freqBandMinMhz = v.substring(mn + 4).toFloat();
  int mx = v.indexOf("max:");
  if (mx >= 0) freqBandMaxGhz = v.substring(mx + 4).toFloat();
  if (genFreqOverride > 0 && genFreqOverride <= GEN_MAX_HZ) genHz = genFreqOverride;
}

void rpcD6Freq(String v) {
  long x = v.toInt();
  bool neg = x < 0;
  if (neg) x = -x;
  if (x > 65535L) x = 65535L;
  d6Frame[0] = neg ? 0xFF : 0xFE;
  d6Frame[1] = (uint8_t)((x >> 8) & 0xFF);
  d6Frame[2] = (uint8_t)(x & 0xFF);
  d6FramePend = true;                   // играет d6Tick после текста
}

/* v2.48: "off:neg:last:hex" — кусок кадра 16x12 (hex, 2 знака на точку). */
void rpcD6Img(String v) {
  int a = v.indexOf(':'), b = v.indexOf(':', a + 1), c = v.indexOf(':', b + 1);
  if (a < 0 || b < 0 || c < 0) return;
  int off = v.substring(0, a).toInt();
  bool neg = v.substring(a + 1, b).toInt() != 0;
  bool last = v.substring(b + 1, c).toInt() != 0;
  String hx = v.substring(c + 1);
  for (unsigned i = 0; i + 1 < hx.length(); i += 2) {
    int p = off + (int)(i / 2);
    if (p < 0 || p >= D6_IMG_N) break;
    char t[3] = {hx[i], hx[i + 1], 0};
    d6ImgIn[p] = (uint8_t)strtoul(t, nullptr, 16);
  }
  if (last) { d6ImgInNeg = neg; d6ImgRdy = true; }
}

/* v2.50/v2.51: "neg:hex[:f0,f1,...,f23]" — чистый кадр 32x24 для D4 (формат
 * как у d6pure) + необязательный профиль знаковых частот по строкам (Гц,
 * -2000..2000), который считает тензорная сеть платы. */
void rpcD4Pure(String v) {
  int a = v.indexOf(':');
  if (a < 0) return;
  int b = v.indexOf(':', a + 1);
  String hx = (b < 0) ? v.substring(a + 1) : v.substring(a + 1, b);
  if (hx.length() < D6P_N / 4) return;
  for (unsigned i = 0; i < D6P_N / 4; i++) {
    char c = hx[i];
    uint8_t n = (c >= 'a') ? (uint8_t)(c - 'a' + 10) : (uint8_t)(c - '0');
    for (uint8_t k = 0; k < 4; k++) d4fIn[i * 4 + k] = (n >> (3 - k)) & 1;
  }
  d4fProfOn = false;
  if (b > 0) {
    String pf = v.substring(b + 1);
    int pos = 0, r = 0;
    while (r < D6P_H && pos <= (int)pf.length()) {
      int c = pf.indexOf(',', pos);
      String one = (c < 0) ? pf.substring(pos) : pf.substring(pos, c);
      long x = one.toInt();
      if (x > D4F_MAX_HZ) x = D4F_MAX_HZ;
      if (x < -D4F_MAX_HZ) x = -D4F_MAX_HZ;
      d4fProf[r++] = (int16_t)x;
      if (c < 0) break;
      pos = c + 1;
    }
    d4fProfOn = (r == D6P_H);
  }
  d4fRdy = true;
}

/* v2.49: "neg:hex" — чистый кадр 32x24, 4 точки на hex-знак (старший бит
 * первым). hex = 192 знака. */
void rpcD6Pure(String v) {
  int a = v.indexOf(':');
  if (a < 0) return;
  bool neg = v.substring(0, a).toInt() != 0;
  String hx = v.substring(a + 1);
  if (hx.length() < D6P_N / 4) return;
  for (unsigned i = 0; i < D6P_N / 4; i++) {
    char c = hx[i];
    uint8_t n = (c >= 'a') ? (uint8_t)(c - 'a' + 10) : (uint8_t)(c - '0');
    for (uint8_t k = 0; k < 4; k++) d6pIn[i * 4 + k] = (n >> (3 - k)) & 1;
  }
  d6pInNeg = neg; d6pRdy = true;
}

/* v2.48: полярность D4: "-1" / "0" / "1". */
void rpcD4Pol(String v) {
  long x = v.toInt();
  d4Pol = x < 0 ? -1 : (x > 0 ? 1 : 0);
}

