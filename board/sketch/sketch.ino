/* ----------------------------- МИКРОФОН ---------------------------------- */
/* Считаем переходы уровня на D12/D13 (модули звука с цифровым выходом DO;
 * полярность не важна — считаем оба фронта). Каждые MIC_WIN_MS обновляем
 * сглаженную громкость micLevel 0..100 — она поднимает частоту генератора.  */
void micTick() {
  for (uint8_t k = 0; k < MIC_PINS_N; k++) {
    bool s = digitalRead(MIC_PIN[k]) == HIGH;
    if (s != micLast[k]) { micLast[k] = s; if (micHits < 250) micHits++; }
  }
  if (millis() - tMic < MIC_WIN_MS) return;
  tMic = millis();
  int inst = (int)micHits * 100 / MIC_HITS_MAX; if (inst > 100) inst = 100;
  micHits = 0;
  micLevel = (uint8_t)(((uint16_t)micLevel * 3 + (uint16_t)inst) / 4);  // EMA
  /* анти-заводка голоса (v1.9): следим за перегрузом микрофона */
  if (micLevel > MIC_HOT_LEVEL) {
    if (!micHotSince) micHotSince = millis();
  } else {
    micHotSince = 0;
  }
}

/* ----------------------------- SETUP / LOOP ------------------------------ */
/* v2.68: ДИАГНОСТИКА ЗАВИСАНИЙ. bootStage — на каком шаге setup() скетч,
 * loopStage — какую функцию loop() он выполняет; loopCount — проходы loop().
 * Метод diag отвечает из ПОТОКА МОСТА (provide, не provide_safe), то есть
 * даже когда loop() завис: приложение видит, где именно. */
volatile uint8_t  bootStage = 0;
volatile uint8_t  loopStage = 0;
volatile uint32_t loopCount = 0;
String rpcDiag() {
  return String((int)bootStage) + "," + String((int)loopStage) + "," +
         String((unsigned long)loopCount) + "," + String(millis() / 1000UL);
}
static void bootAt(uint8_t st) {
  bootStage = st;
#if USE_RB
  Bridge.notify("on_boot", (int)st);
#endif
}

void setup() {
#if USE_RB
  /* v2.68: МОСТ — ПЕРВЫМ, до шины нейронов, камеры и EEPROM: если что-то
   * из них зависнет, приложение всё равно увидит скетч и шаг зависания */
  Bridge.begin();
  Bridge.notify("$/setMaxMsgSize", 8192);  /* запас на длинные фразы */
  HubOut.mon = Monitor.begin();            /* панель Monitor открыта? */
  rpcRegister();
  bootAt(1);
#else
  HUB_OUT.begin(115200);
#endif
  pinMode(GEN_PIN, OUTPUT);
  digitalWrite(GEN_PIN, LOW);
  pinMode(SPEAKER_PIN, OUTPUT);        // динамик (v1.9): мотивация говорить
  digitalWrite(SPEAKER_PIN, LOW);
  pinMode(NN_OUT_PIN, OUTPUT);         // v2.22: буфер слов (UTF-8 байты) на D6 (PWM)
  analogWrite(NN_OUT_PIN, 0);
  for (uint8_t k = 0; k < MIC_PINS_N; k++) pinMode(MIC_PIN[k], INPUT);
  /* v2.94.3: VR3 при старте НЕ трогаем (прерывание на D12 включает Python
   * командой vr_enable, когда мост уже жив) — иначе сбой прерывания мог
   * уронить скетч на старте, и мост молчал */
#if !LINK_SW_WIRE
  for (uint8_t b = 0; b < 4; b++) pinMode(MUX_PINS[b], OUTPUT);
#endif

  bootAt(2);                     // v2.68: шина нейронов
#if LINK_SW_WIRE
  NeuroBus.begin();
  NeuroBus.setClock(20000);      // v2.23: 20 кГц вместо 100 — длинные провода
                                 // до нейронов перестают терять биты
  i2cBusRecover();               // v2.23: разморозить шину после сброса платы
#else
  NeuroSer.begin(9600);
#endif

/* v2.30: приёмник камеры по UART — стартует всегда (кадры копятся, даже
 * если мозг их не спрашивает); при LINK_SW_WIRE 0 Serial1 может быть
 * занят нейронами — тогда эту секцию придётся убрать вместе с камерой */
  bootAt(3);                     // v2.68: приёмник камеры
#if defined(ARDUINO_ARCH_STM32)
  CAMRX.setRxBufferSize(2048);   // большой приёмный буфер: loop занят нейронами
#endif
  CAMRX.begin(CAMRX_BAUD);
  HUB_OUT.print("[CAM-UART] приёмник кадров готов: ");
  HUB_OUT.print(CAMRX_BAUD);
  HUB_OUT.println(" бод; TX ESP32-CAM (GPIO13) -> RX Serial1/D0, GND общий");

#if USE_RB
  HUB_OUT.println("[HUB] Arduino_RouterBridge: OK (RPC App Lab), мост поднят первым (v2.68)");
#elif USE_BRIDGE
  Bridge.begin();
  HUB_OUT.println("[HUB] Arduino_Bridge: OK");
#else
  HUB_OUT.println("[HUB] мостов нет: работаю по протоколу GETK/PUTK");
#endif
#if BUS_READY == 2
  HUB_OUT.println("[HUB] ВНИМАНИЕ: SoftwareWire не найден, использую аппаратный Wire (SDA/SCL)");
#endif
  HUB_OUT.println("[HUB] Мозг-12 v2.4-app (App Lab): шина D4 -> A0 нейронов; RPC RouterBridge");
  HUB_OUT.println("[HUB] Частота = покой + камера(val_b) + микрофон(D12/D13) + текст + спайки");
  HUB_OUT.println("[HUB] Динамик D8: мотивация говорить (голосовая петля, VOX= в total_val_c)");
  bootAt(4);                           // v2.68: EEPROM
  hzcfgLoad();                         // v2.2: настройки из Studio (EEPROM)
  if (genHz < cfgMinHz) genHz = cfgMinHz;
  if (genHz > cfgMaxHz) genHz = cfgMaxHz;
  HUB_OUT.print("[HUB] Частоты (Studio/EEPROM): min="); HUB_OUT.print(cfgMinHz);
  HUB_OUT.print(" max="); HUB_OUT.print(cfgMaxHz);
  HUB_OUT.print(" cam="); HUB_OUT.print(cfgCamSpan);
  HUB_OUT.print(" mic="); HUB_OUT.print(cfgMicSpan);
  HUB_OUT.print(" txt="); HUB_OUT.print(cfgTxtSpan);
  HUB_OUT.print(" spk="); HUB_OUT.println(cfgSpkSpan);
  /* v2.3: НЕЙРОСЕТЬ БУКВ — веса из EEPROM или приоры речи */
  if (!netLoad()) {
    netInitWeights();
    HUB_OUT.println("[HUB] Буквогенератор v2.3: веса инициализированы (приоры речи)");
  } else {
    HUB_OUT.println("[HUB] Буквогенератор v2.3: веса загружены из EEPROM");
  }
  netSave();
  /* v2.26: СЛОВОГЕНЕРАТОР — слова из словаря, веса слов в EEPROM */
  for (uint8_t i = 0; i < NEURONS; i++) idSeen[i] = -1;
  if (!wordsLoad()) {
    memset(wordW, 0, sizeof(wordW));
    memset(wordCtx, 0, sizeof(wordCtx));
    HUB_OUT.print("[HUB] Словогенератор v2.26: словарь ");
    HUB_OUT.print((unsigned)WD_N);
    HUB_OUT.println(" слов (веса с нуля, учитель подкрепляет)");
  } else {
    HUB_OUT.print("[HUB] Словогенератор v2.26: ");
    HUB_OUT.print((unsigned)WD_N);
    HUB_OUT.println(" слов, веса из EEPROM");
  }
  wordsSave();
  HUB_OUT.println("[HUB] Буквогенератор: 1..33 -> буквы + пробел/запятая/точка;");
  HUB_OUT.println("[HUB]   номер буквы -> тег частоты (нейроны слышат без правки кода);");
  HUB_OUT.println("[HUB]   слова -> STIM нейронам + мелодия D8; фразы -> SAY= (TTS/чат);");
  HUB_OUT.println("[HUB]   LLM-учитель: teach_score=±1, teach_last/teach_shape — точечно");
  strlcpy(val_c, "boot", VAL_C_SIZE);
  strlcpy(val_b, "no-video", VAL_B_SIZE);
  strlcpy(cloud_buf, "no-cloud", CLOUD_BUF_SIZE);
  strlcpy(skill_out, "no-skill", SKILL_OUT_SIZE);
  analyzeAndPrint(); tAnalyze = 0;
  nextEdgeUs = micros();
  bootAt(9);                           // v2.68: setup() завершён
}

void loop() {
  loopCount++;                       // v2.68: шаг loop() — для diag
  /* v2.93: приёмник камеры опрашиваем МЕЖДУ всеми этапами: на 460800 бод
   * аппаратный буфер Serial1 заполняется за ~1-2 мс, и любой медленный этап
   * (I2C нейронов, АЦП, RPC) раньше рвал кадры (bad растёт, ok стоит). */
  loopStage = 1;  d4fTick();           camUartTick();   // v2.50: кадр камеры на D4 (если есть)
  loopStage = 2;  freqTick();          camUartTick();   // 1. генератор: меандр genHz на D4 -> A0 всех нейронов
  loopStage = 3;  voiceTick();         camUartTick();   // 2. динамик (v1.9): голос мозга / мотивация говорить
  loopStage = 4;  micTick();           camUartTick();   // 3. микрофон (KY-037 на D10/D11)   // 3. микрофон: звук на D12/D13 -> micLevel
  loopStage = 5;  pollNext();          camUartTick();   // 4. опрос нейронов -> val_c
  loopStage = 6;  letterTick();        camUartTick();   // 5. буквогенератор (v2.3): нейросеть 1..33 -> буквы -> слова
  loopStage = 7;  d6Tick();            camUartTick();   // 5a. v2.22: проигрывание буфера слов на D6 (PWM)
  particleTick();          // v2.92: дискретные кванты частиц, если включены
  sampleCapNoise();        // v2.93: шум конденсатора (1 выборка / 4 мс)
  noiseAsStim();           // шум -> STIM нейронам + подъём genHz
  updateLearningScale();   // частота D6 + шум -> скорость весов
  loopStage = 8;  camUartTick();       // 5b. v2.30: приём кадров камеры по UART (ESP32-CAM)
  loopStage = 9;  neuroAssignTick();   camUartTick();   // 5c. v2.33: назначение нейронов — один шаг, БЕЗ delay()
  loopStage = 10; eePumpTick();        camUartTick();   // 5d. v2.67: веса в EEPROM — по 2 байта за проход
  loopStage = 11; bridgeSync();        camUartTick();   // 6. обмен с Linux-стороной (val_b, chat_out, teach, speak / total_val_c)
  loopStage = 12; analyzeAndPrint();   camUartTick();   // 7. анализ val_c (+val_b, звук) -> частота и total_val_c
  loopStage = 0;
  /* v2.94.5: ДАТЬ ПОТОКУ МОСТА ПРОЦЕССОР. loop() на Zephyr — обычный поток;
   * если он не спит, поток RouterBridge (приём вызовов от Linux) не получает
   * времени: от скетча уведомления уходят, а ВСЕ вызовы из Python (diag,
   * cam_frame_info, say_wave…) — «timed out». До v2.93 спать заставляли
   * 8 analogRead за проход (АЦП ждёт семафор); с v2.93 АЦП читается редко —
   * и мост задыхался. Теперь — сон 1 мс каждые 3 мс (кадры камеры копит
   * драйвер UART по прерыванию). */
  static uint32_t yieldMs = 0;
  if ((uint32_t)(millis() - yieldMs) >= 3) {
    yieldMs = millis();
    delay(1);
  }
}
