/* v2.48: КАДР ESP32-CAM НА D6 — САМИМ КАДРОМ (растр), а не байтами файла.
 * Python уменьшает кадр до 16x12 серых точек и шлёт RPC "d6img"; каждая
 * точка звучит УРОВНЕМ (duty = яркость, 1..254), строка за строкой, как
 * развёртка телевизора. Служебные уровни: 255 — начало/конец кадра (дважды
 * в начале), 0 вместо точки — конец строки. Поток точек и поток мысли идут
 * по одному пину с ЦИКЛОМ из 4 слотов по D6_STEP_MS: слот 0 — байт мысли
 * (или кадр знака), слот 1 — точка кадра (отставание кадра от мысли = pi/2),
 * слоты 2-3 — тишина. При отрицательной частоте (опция облака) точка идёт в
 * слоте 3 — отставание -pi/2, т.е. обратное направление «вращения»; темп
 * слотов тот же. Это и есть честный смысл знака: порядок двух потоков. */
#define D6_IMG_W   16
#define D6_IMG_H   12
#define D6_IMG_N   (D6_IMG_W * D6_IMG_H)
#define D6_IMG_LEN (2 + D6_IMG_H * (D6_IMG_W + 1) + 1)   // поток служебных+точек
uint8_t  d6ImgIn[D6_IMG_N];             // принимаемый кадр (по кускам)
uint8_t  d6Img[D6_IMG_N];               // играемый кадр
bool     d6ImgInNeg = false;
bool     d6ImgRdy = false;              // новый кадр принят целиком
bool     d6ImgRun = false;              // развёртка идёт
bool     d6ImgNeg = false;              // отставание -pi/2 (отрицательная частота)
uint16_t d6ImgIdx = 0;                  // сколько элементов потока сыграно
uint8_t  d6Ph = 0;                      // слот цикла 0..3
uint32_t d6SlotMs = 0;

uint8_t d6ImgTok(uint16_t i) {
  if (i < 2) return 255;
  uint16_t k = i - 2;
  uint16_t r = k / (D6_IMG_W + 1), c = k % (D6_IMG_W + 1);
  if (r >= D6_IMG_H) return 255;        // конец кадра
  if (c == D6_IMG_W) return 0;          // конец строки
  return d6Img[r * D6_IMG_W + c];
}

