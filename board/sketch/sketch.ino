/* ----------------------------- УТИЛИТЫ ----------------------------------- */
uint32_t fnv1a(const char *s) {
  uint32_t h = 2166136261u;
  while (*s) { h ^= (uint8_t)*s++; h *= 16777619u; }
  return h;
}

/* Оставляем только безопасные символы, ';'->',' , ':'->'/' , '|'->'!' */
void sanitize(char *s) {
  for (; *s; s++) {
    uint8_t c = (uint8_t)*s;
    if (c == ';') *s = ',';
    else if (c == ':') *s = '/';
    else if (c == '|') *s = '!';
    else if (c < 0x20 || c == 0x7F) *s = ' ';
  }
}

/* v2.24: РЕМОНТ UTF-8 НА МЕСТЕ. sanitize() пропускает старшие байты
 * (0x80..0xFF) как есть, а с шумящей шины I2C приходит МУСОР: обрыв
 * посреди двухбайтовой буквы (0xD0/0xD1 без продолжения), случайные
 * 0xFF/0xAE/0x93. Такая строка в on_msg/on_state роняла декодер моста
 * Python («'utf-8' codec can't decode byte ...») и событие терялось
 * ЦЕЛИКОМ. Проходим строку: валидные последовательности (1..4 байта,
 * включая кириллицу D0/D1 xx) остаются как были, битый байт становится
 * пробелом. Строка гарантированно корректный UTF-8. */
void utf8Fix(char *s) {
  char *d = s;
  while (*s) {
    uint8_t c = (uint8_t)*s;
    uint8_t need;
    if (c < 0x80)            need = 0;
    else if ((c & 0xE0) == 0xC0) need = 1;
    else if ((c & 0xF0) == 0xE0) need = 2;
    else if ((c & 0xF8) == 0xF0) need = 3;
    else { *d++ = ' '; s++; continue; }   // одинокие 10xxxxxx / 11111xxx
    bool ok = true;
    for (uint8_t k = 1; k <= need; k++) {
      uint8_t cc = (uint8_t)s[k];
      if (!cc || (cc & 0xC0) != 0x80) { ok = false; break; }  // обрыв
    }
    if (!ok) { *d++ = ' '; s++; continue; }
    for (uint8_t k = 0; k <= need; k++) *d++ = s[k];  // буква цела
    s += need + 1;
  }
  *d = 0;
}

/* --------------------- НАСТРОЙКИ ЧАСТОТ (v2.2, STUDIO) -------------------- */
void broadcastGen();                  // форвард (определена ниже)

static void eewrite(int addr, uint8_t v) {
#if USE_EEPROM
  if (EEPROM.read(addr) != v) EEPROM.write(addr, v);
#else
  (void)addr; (void)v;
#endif
}

void hzcfgSave() {
  uint16_t *vals[6] = {&cfgMinHz, &cfgMaxHz, &cfgCamSpan,
                       &cfgMicSpan, &cfgTxtSpan, &cfgSpkSpan};
#if USE_EEPROM
  eewrite(0, HZCFG_MAGIC);
  for (uint8_t k = 0; k < 6; k++) {
    uint16_t x = *vals[k];
    eewrite(HZCFG_ADDR + k * 2, (uint8_t)(x & 0xFF));
    eewrite(HZCFG_ADDR + k * 2 + 1, (uint8_t)(x >> 8));
  }
#endif
}

void hzcfgLoad() {
#if USE_EEPROM
  if (EEPROM.read(0) != HZCFG_MAGIC) return;
  uint16_t *vals[6] = {&cfgMinHz, &cfgMaxHz, &cfgCamSpan,
                       &cfgMicSpan, &cfgTxtSpan, &cfgSpkSpan};
  for (uint8_t k = 0; k < 6; k++) {
    uint16_t x = (uint16_t)EEPROM.read(HZCFG_ADDR + k * 2)
               | (uint16_t)(EEPROM.read(HZCFG_ADDR + k * 2 + 1) << 8);
    if (x) *vals[k] = x;              // 0 = оставить значение по умолчанию
  }
  if (cfgMaxHz <= cfgMinHz + 100) cfgMaxHz = cfgMinHz + 100;
#endif
}

/* Применить строку "min,max,cam,mic,txt,spk" (из Cloud Studio через Linux):
 * парсим, клэмпим, сохраняем в EEPROM и сразу перезапускаем шину. */
void hzcfgApply(const char *s) {
  long v[6] = {0, 0, 0, 0, 0, 0}; uint8_t i = 0;
  for (; *s && i < 6; s++) {
    if (*s == ',') { if (v[i] || i) i++; continue; }
    if (*s < '0' || *s > '9') continue;
    v[i] = v[i] * 10 + (*s - '0');
    if (v[i] > 100000) v[i] = 100000;
  }
  if (v[0]) cfgMinHz = (uint16_t)(v[0] < 60 ? 60 : (v[0] > 1000 ? 1000 : v[0]));
  if (v[1]) cfgMaxHz = (uint16_t)(v[1] < 300 ? 300 : (v[1] > 4000 ? 4000 : v[1]));
  if (v[2] >= 0 && v[2] <= 1000) cfgCamSpan = (uint16_t)v[2];
  if (v[3] >= 0 && v[3] <= 1000) cfgMicSpan = (uint16_t)v[3];
  if (v[4] >= 0 && v[4] <= 1000) cfgTxtSpan = (uint16_t)v[4];
  if (v[5] >= 0 && v[5] <= 1000) cfgSpkSpan = (uint16_t)v[5];
  if (cfgMaxHz <= cfgMinHz + 100) cfgMaxHz = cfgMinHz + 100;
  if (genHz < cfgMinHz) genHz = cfgMinHz;
  if (genHz > cfgMaxHz) genHz = cfgMaxHz;
  hzcfgSave();
  broadcastGen();                     // пересчитать частоту немедленно
  txtBump(20);                        // нейроны «замечают» перенастройку
}

/* Вклад камеры 0..100: считаем объекты в val_b (YOLO-сводка).
 * Формат: "person 0.91, dog 0.77" — разделители ','/'!'/' '; пусто,
 * "объектов нет" или "no-video" (нет цифр) = 0. */
uint8_t camScore() {
  bool digits = false; uint8_t seps = 0;
  for (const char *p = val_b; *p; p++) {
    if (*p >= '0' && *p <= '9') digits = true;
    else if (*p == ',' || *p == '!' || *p == ';') seps++;
  }
  if (!digits) return 0;
  uint8_t obj = seps + 1; if (obj > 4) obj = 4;
  return obj * 25;                     // 25..100
}

/* Всплеск текст-активности: чат/свои реплики/облако */
void txtBump(uint8_t n) {
  int v = (int)txtLevel + n; if (v > 100) v = 100;
  txtLevel = (uint8_t)v;
}

/* ----------------------------- ДИНАМИК (v1.9) ---------------------------- */
/* Голос мозга: фраза из 2-4 посылок тона, построенная от текущей частоты
 * шины genHz (квинтовые ходы вверх). Неблокирующий программный меандр —
 * работает и без tone() (важно для Zephyr-ядра UNO Q).
 * Анти-заводка: если микрофон перегружен (динамик слишком близко / громко)
 * дольше MIC_HOT_MS — голос молчит VOICE_COOL_MS, петля размыкается.      */
void voiceSay(uint16_t hzBase, uint8_t tones) {
  if (!voiceOn) return;
  if (voxSteps || melLen) return;         // уже говорим — не перебиваем
  if (micHotSince && millis() - micHotSince > MIC_HOT_MS &&
      millis() - lastPhraseMs < VOICE_COOL_MS)
    return;                             // анти-заводка: микрофон перегружен
  if (hzBase < 150) hzBase = 150;
  if (hzBase > VOICE_TONE_MAX) hzBase = VOICE_TONE_MAX;
  toneHz = hzBase;
  voxSteps = tones ? tones : 3;
  voicePhase = true;
  tVoicePhase = millis();
  nextToneEdgeUs = micros();
  voxCount++;                           // ещё одна фраза в статистику VOX=
}

void voiceTick() {
  if (!voiceOn) {
    if (toneOut) { toneOut = false; digitalWrite(SPEAKER_PIN, LOW); }
    melLen = 0;
    return;
  }
  if (melLen) { melTick(); return; }      // v2.3: произносим слово нотами
  if (!voxSteps) {
    if (toneOut) { toneOut = false; digitalWrite(SPEAKER_PIN, LOW); }
    return;
  }
  if (voicePhase) {                     // посылка: программный меандр toneHz
    uint32_t halfUs = 500000UL / toneHz;
    if ((int32_t)(micros() - nextToneEdgeUs) >= 0) {
      toneOut = !toneOut;
      digitalWrite(SPEAKER_PIN, toneOut ? HIGH : LOW);
      nextToneEdgeUs += halfUs;
    }
    if (millis() - tVoicePhase >= VOICE_MS) {        // конец посылки
      voicePhase = false; tVoicePhase = millis();
      toneOut = false; digitalWrite(SPEAKER_PIN, LOW);
    }
  } else if (millis() - tVoicePhase >= VOICE_GAP_MS) { // конец паузы
    voxSteps--;
    if (voxSteps) {                     // следующая посылка — квинта вверх
      voicePhase = true; tVoicePhase = millis();
      toneHz = (uint16_t)(toneHz * 3 / 2);
      if (toneHz > VOICE_TONE_MAX + 900) toneHz = (uint16_t)(toneHz * 2 / 3);
      nextToneEdgeUs = micros();
    } else {
      lastPhraseMs = millis();          // фраза закончилась
    }
  }
}

/* --------------------- ПРОИЗНОШЕНИЕ СЛОВ (v2.3) -------------------------- */
/* Слово «проговаривается» динамиком D8 МЕЛОДИЕЙ: каждая буква 1..33 — своя
 * нота (250 + номер*24 Гц), 80 мс. Это и есть учатие произношения в скетче:
 * слово из текущего буфера сборки звучит целиком, как короткое «слово».
 * Неблокирующая очередь шагов (нота/пауза) поверх голосового движка.       */
void melStart() {
  if (voxSteps) { melLen = 0; return; }   // не перебивать фразу мотивации
  melIdx = 0; melTone = true; tMel = millis();
  if (mel[0].hz) toneHz = mel[0].hz;
  nextToneEdgeUs = micros();
}

void melTick() {
  if (melTone) {                          // нота: программный меандр
    uint16_t hz = mel[melIdx].hz;
    if (hz == 0) {                        // v2.14: кадр-пауза — тишина на D8
      if (toneOut) { toneOut = false; digitalWrite(SPEAKER_PIN, LOW); }
    } else {
      if (hz < 150) hz = 150;
      uint32_t halfUs = 500000UL / hz;
      if ((int32_t)(micros() - nextToneEdgeUs) >= 0) {
        toneOut = !toneOut;
        digitalWrite(SPEAKER_PIN, toneOut ? HIGH : LOW);
        nextToneEdgeUs += halfUs;
      }
    }
    if (millis() - tMel >= mel[melIdx].ms) {
      melTone = false; tMel = millis();
      toneOut = false; digitalWrite(SPEAKER_PIN, LOW);
    }
  } else if (millis() - tMel >= mel[melIdx].ms) {   // пауза кончилась
    melIdx++;
    if (melIdx >= melLen) { melLen = 0; lastPhraseMs = millis(); return; }
    melTone = true; tMel = millis();
    if (mel[melIdx].hz) toneHz = mel[melIdx].hz;
    nextToneEdgeUs = micros();
  }
}

/* Номер буквы по её 2 байтам UTF-8 (0 = не буква) */
uint8_t letterNumOf(const char *two) {
  for (uint8_t i = 0; i < 33; i++)
    if (RU33[i][0] == two[0] && RU33[i][1] == two[1]) return i + 1;
  return 0;
}

void voiceWord(const char *w) {
  if (!voiceOn || melLen) return;         // голос выключен или уже звучит слово
  for (uint16_t p = 0; w[p] && melLen < MEL_MAX - 2; p += 2) {
    uint8_t num = letterNumOf(w + p);
    if (!num) break;
    uint16_t hz = 250 + num * 24; if (hz > 1100) hz = 1100;
    mel[melLen].hz = hz;  mel[melLen].ms = 80;   melLen++;   // нота буквы
    mel[melLen].hz = 0;   mel[melLen].ms = 34;   melLen++;   // пауза
  }
  if (melLen) { mel[melLen - 1].ms = 130; melStart(); }    // хвост слова длиннее
}

/* --------------------- НЕЙРОСЕТЬ БУКВ (v2.3) ------------------------------ */
/* Перцептрон 10x36: на входах — состояние мозга (частота шины, звук, камера,
 * текст, спайки, предыдущий класс, длина слова/фразы, флаг «после запятой»),
 * на выходах — 33 буквы + ПРОБЕЛ + ЗАПЯТАЯ + ТОЧКА. Победитель — аргмакс с
 * 20% исследованием («лепет»: учителю есть что оценивать). Выбор ВСЕГДА
 * делает сама сеть; LLM-ядро (ключ "teach" = +1/-1) только подкрепляет
 * решения завершённой фразы — УЧИТ, а не выбирает за мозг.
 * Веса — int8, хранятся в EEPROM (переживают перезагрузку).                */
static uint32_t g_lcg = 0x2F6E2B1;
static uint32_t lcgNext() { g_lcg = g_lcg * 1664525u + 1013904223u; return g_lcg; }
static int8_t netRnd(int8_t lim) { return (int8_t)(lcgNext() % (2 * (long)lim + 1)) - lim; }

void netInitWeights() {
  for (uint8_t o = 0; o < NET_OUT; o++)
    for (uint8_t i = 0; i < NET_IN; i++)
      netW[o][i] = netRnd(6);
  /* приоры «речевой механики» — чтобы с первого включения лепет был похож
   * на речь: буквы охотнее знаков, пробел — на длинном слове, точка — на
   * длинной фразе, после запятой — пробел */
  for (uint8_t o = 0; o < 33; o++) {
    netW[o][0] += 14;                             // bias: буквы базово
    if (RU_VOW[o]) netW[o][0] += 6;               // гласные чуть чаще
    netW[o][7] -= 3;                              // длинное слово — меньше букв
  }
  netW[CL_SPACE][0] += 10; netW[CL_SPACE][7] += 30; netW[CL_SPACE][9] += 25;
  netW[CL_COMMA][0] += 2;  netW[CL_COMMA][7] += 12; netW[CL_COMMA][8] += 15;
  netW[CL_DOT][0]   += 2;  netW[CL_DOT][8]   += 40;
  netDirty = true;
}

/* v2.67: ЗАПИСЬ В EEPROM ПО ЧУТЬ-ЧУТЬ. На UNO Q EEPROM — эмуляция во
 * flash: каждая запись байта может стоить миллисекунды-десятки мс. Раньше
 * сохранение весов писало сотни байт ПОДРЯД в loop() — скетч замирал на
 * секунды, сводки по мосту не шли (чип «мост: молчит/ждёт скетч»), D4/D6
 * запинались. Теперь netSave()/wordsSave() только ставят запись в очередь,
 * а eePumpTick() в loop() пишет не больше EE_STEP изменённых байт за проход
 * (признак «веса записаны» — последним, после данных). */
#define EE_STEP 2
uint8_t  eePend = 0;          // 1 — веса букв, 2 — веса слов
uint8_t  eeWhat = 0;          // что пишем сейчас
uint16_t eeCur = 0;           // номер байта в текущей записи
void netSave() {
#if USE_EEPROM
  if (!netDirty) return;
  eePend |= 1;
#endif
  netDirty = false;
}

bool netLoad() {
#if USE_EEPROM
  if (EEPROM.read(NET_MAGIC_ADDR) != NET_MAGIC) return false;
  uint8_t *p = (uint8_t *)netW;
  for (uint16_t k = 0; k < NET_OUT * NET_IN; k++) p[k] = EEPROM.read(NET_WADDR + k);
  return true;
#else
  return false;
#endif
}

/* Входы сети 0..100 из текущего состояния мозга */
void netInputs(int8_t *x) {
  uint16_t span = (cfgMaxHz > cfgMinHz) ? (cfgMaxHz - cfgMinHz) : 1;
  int32_t g = ((int32_t)genHz - (int32_t)cfgMinHz) * 100 / span;
  if (g < 0) g = 0;
  if (g > 100) g = 100;
  x[0] = 100;                               // смещение
  x[1] = (int8_t)g;                         // частота шины (GEN)
  x[2] = (int8_t)micLevel;                  // звук (D12/D13)
  x[3] = (int8_t)camScore();                // камера (val_b/YOLO)
  x[4] = (int8_t)txtLevel;                  // текст-канал
  x[5] = (int8_t)spkLvlLast;                // спайки нейронов
  x[6] = (int8_t)(lastClass == 255 ? 0 : (int32_t)lastClass * 100 / 35);
  x[7] = (int8_t)((int32_t)genWordLen / 2 * 100 / WORD_MAX);   // букв в слове
  x[8] = (int8_t)((int32_t)genSentChars * 100 / SENT_MAX);     // длина фразы
  x[9] = afterPunct ? 100 : 0;              // предыдущий символ — запятая
}

uint8_t netPick(const int8_t *x) {
  int32_t best = -2000000000L; uint8_t bo = 0;
  for (uint8_t o = 0; o < NET_OUT; o++) {
    int32_t acc = 0;
    for (uint8_t i = 0; i < NET_IN; i++) acc += (int32_t)netW[o][i] * x[i];
    int32_t act = (acc >> 6) + netRnd(2);   // лёгкий дрейф = «живость»
    if (act > best) { best = act; bo = o; }
  }
  if ((lcgNext() % 100) < 5) bo = lcgNext() % 33;    // v2.85: было 20% — чистый лепет давал «ИЧИИЕИФИИЪ»;
                                                     // оставляем 5% исследования, остальное — сеть
  return bo;
}

/* ------------- СЛОВОГЕНЕРАТОР (v2.26): СЛОВА ИЗ СЛОВАРЯ ------------------
 * Слова выбирает САМА сеть: у каждого слова вес wordW (учитель
 * подкрепляет) и контекстные веса wordCtx (входы: bias, текст-канал,
 * звук, спайки) — слово «к месту» звучит чаще. Словарь — 64 частых
 * русских слова ЗАГЛАВНЫМИ (тот же алфавит, что у буквенной сети).
 * Веса — в EEPROM (после весов букв, 460+). 15% — исследование:
 * пробуем редкие слова, учителю есть что оценивать.                    */
#define WD_N        64      // слов в словаре
#define WD_MAXL     8       // букв в слове словаря (2 байта UTF-8 + NUL)
#define WD_MODE_PCT 92      // v2.85: было 70 — 30% чистого буквенного лепета
                            // давали бессвязные «слова». Теперь почти всегда
                            // словарь; буквенная сеть остаётся для обучения.
#define WORD_MAGIC_ADDR 455 // EEPROM: признак записанных весов слов
#define WORD_WADDR      460 // EEPROM: wordW[WD_N] + wordCtx[WD_N][4]
#define WORD_MAGIC      0x5C

const char WDICT[WD_N][WD_MAXL * 2 + 1] = {
  "ПРИВЕТ","КАК","ДЕЛА","ЧТО","КТО","ГДЕ","КОГДА","ПОЧЕМУ","Я","ТЫ","МЫ",
  "ОНИ","ХОЧУ","ЗНАЮ","ДУМАЮ","ВИЖУ","СЛЫШУ","ГОВОРЮ","ПОНЯЛ","СПАСИБО",
  "ИЗВИНИ","ХОРОШО","ПЛОХО","МОЖНО","НУЖНО","НАДО","ДАВАЙ","ДА","НЕТ",
  "ТУТ","ТАМ","СЕЙЧАС","ПОТОМ","ВСЕГДА","НИКОГДА","УЧУСЬ","РАСТУ","ДЕНЬ",
  "НОЧЬ","ВРЕМЯ","ДОМ","МИР","ДРУГ","МОЗГ","НЕЙРОН","ПАМЯТЬ","МЫСЛЬ",
  "СЛОВО","СИЛА","ЖИЗНЬ","ЛЮДИ","ЛЮБЛЮ","ПОМОГИ","СКАЖИ","ЖДУ","ИЩУ",
  "НАШЁЛ","РАД","ЖАЛЬ","ВЕРЮ","ЖИВУ","БУДУ","ЗДЕСЬ","ЕЩЁ"
};

int8_t   wordW[WD_N];               // вес слова (подкрепляет учитель)
int8_t   wordCtx[WD_N][4];          // контекст: bias/текст/звук/спайки
bool     wordsDirty = false;
uint32_t wordsSaveAt = 0;
uint8_t  dictCur = 255;             // текущее словарное слово (255 = лепет)
uint8_t  dictPos = 0;               // сколько букв слова уже вышло
uint8_t  lastWordIdx = 255;         // последнее слово (ждёт оценки учителя)
bool     wordDecFresh = false;
uint32_t wordsPicked = 0;           // сколько слов выбрано из словаря

/* v2.27: СЛОВО ОТ МОЗГА (большой словарь ru_top.json / облако). Мозг сам
 * выбирает слово (перекос к частым) и присылает RPC word_push. Слово
 * произносится обычным конвейером (dictLetterTick): только там буквы
 * получают решения учителя, теги нейронам и SAY=. Встроенные 64 слов —
 * резерв (мост молчит).
 * v2.34: ПАМЯТЬ ПЛАТЫ НА КАЖДОЕ СЛОВО — кольцевая ОЧЕРЕДЬ. Мозг шлёт
 * слова раз в 0.5 с, а конвейер произносит слово за ~0.4-1.5 с: старый
 * слот на одно слово (wordPushFresh) терял всё, кроме последнего.
 * Теперь КАЖДОЕ слово ждёт своей очереди в wordQ и произносится по
 * порядку; при переполнении слово честно считается потерянным
 * (wordQDrop). Глубину очереди и счётчики мозг видит RPC word_q. */
char     wordPush[WORD_MAX * 2 + 2];   // слово, взятое из очереди (стойло)
char     wordCur[WORD_MAX * 2 + 2];    // слово, которое произносим сейчас
uint8_t  dictSrc = 0;                  // 0 = WDICT[dictCur], 1 = wordCur
uint32_t wordsPushed = 0;              // сколько слов пришло от мозга
#define WQ_N 20                        // слов в очереди платы (память)
char     wordQ[WQ_N][WORD_MAX * 2 + 2];
uint8_t  wordQHead = 0;                // куда писать следующее слово
uint8_t  wordQTail = 0;                // откуда читать следующее слово
uint8_t  wordQCnt = 0;                 // сколько слов ждёт очереди
uint32_t wordQDrop = 0;                // потеряно при переполнении (честно)

int8_t wdictFind(const char *w) {
  for (uint8_t i = 0; i < WD_N; i++)
    if (strcmp(WDICT[i], w) == 0) return (int8_t)i;
  return -1;
}

void rpcWordPush(String w) {
  /* строка от мозга: ЗАГЛАВНЫЕ кириллические буквы (2 байта UTF-8);
   * каждую пару проверяем по RU33 — мусор от шины не произносим.
   * v2.34: слово встаёт в ОЧЕРЕДЬ (память платы на каждое слово).
   * v2.38: ОДИНОЧНЫЙ ЗНАК ПРЕПИНАНИЯ (",", ".", "!", "?") — тоже запись
   * словаря мозга: знак в ту же очередь, механика знаков в letterTick
   * (boardMarkTick). СЕТЬ БУКВ НЕ ТРОНУТА (10x36, как была). */
  char buf[WORD_MAX * 2 + 4];
  strlcpy(buf, w.c_str(), sizeof(buf));
  utf8Fix(buf);
  if (buf[0] && !buf[1] && strchr(",.!?", buf[0])) {   // v2.38: знак
    if (wordQCnt >= WQ_N) {               // очередь полна — честно
      wordQDrop++;
      return;
    }
    wordQ[wordQHead][0] = buf[0];
    wordQ[wordQHead][1] = 0;
    wordQHead = (uint8_t)((wordQHead + 1) % WQ_N);
    wordQCnt++;
    wordsPushed++;
    HUB_OUT.print("[GEN] знак от мозга (в очереди ");
    HUB_OUT.print(wordQCnt);
    HUB_OUT.print("): "); HUB_OUT.println(buf);
    return;
  }
  uint8_t n = 0;
  for (uint16_t p = 0; buf[p] && buf[p + 1] && n < WORD_MAX; p += 2) {
    if (!letterNumOf(buf + p)) return;    // не кириллица — слово не берём
    n++;
  }
  if (!n) return;
  if (wordQCnt >= WQ_N) {               // очередь полна — честно, без вранья
    wordQDrop++;
    return;
  }
  strlcpy(wordQ[wordQHead], buf, sizeof(wordQ[0]));
  wordQHead = (uint8_t)((wordQHead + 1) % WQ_N);
  wordQCnt++;
  wordsPushed++;
  HUB_OUT.print("[GEN] слово от мозга (в очереди ");
  HUB_OUT.print(wordQCnt);
  HUB_OUT.print("): "); HUB_OUT.println(buf);
}

/* v2.34: СОСТОЯНИЕ ОЧЕРЕДИ СЛОВ для мозга — RPC word_q:
 * "q=<ждёт в очереди>;p=<всего пришло>;d=<потеряно при переполнении>".
 * Обработчик мгновенный (только собирает строку). */
String rpcWordQ() {
  return String("q=") + wordQCnt + ";p=" + wordsPushed + ";d=" + wordQDrop;
}

/* v2.28: НАЗНАЧЕНИЕ НОМЕРОВ НЕЙРОНАМ (RPC neuro_assign -> отчёт строкой).
 * Слоты 0..NEURONS-1 опрашиваются; если слот МОЛЧИТ — в общий вызов
 * (адрес 0) уходит "SETID;<n>": её берёт только плата БЕЗ номера
 * (neuron_node v2.6, EEPROM). Через 400 мс слот перепрашивается.
 * ВНИМАНИЕ: пустых плат на шине должно быть НЕ БОЛЬШЕ ОДНОЙ — иначе
 * несколько возьмут один номер (в отчёте будет виден мусор/коллизия).
 * v2.33: НЕБЛОКИРУЮЩЕЕ ИСПОЛНЕНИЕ (прошлая причина таймаутов всего
 * RPC-канала: word_push/cloud_buf_set/chat_stim/say_wave падали в окно
 * блокировки). Обработчик НЕ ждёт — только запускает машину состояний
 * (asgBusy) и мгновенно отвечает "started". Шаги делает
 * neuroAssignTick() из loop(): одна фаза за итерацию, БЕЗ delay().
 * Прогресс/отчёт — RPC neuro_assign_poll ("p:<готово>;<busy|done>;<rep>"). */
uint8_t  asgIdx = 0;          // текущий слот
uint8_t  asgPhase = 0;        // 0 = опрос слота, 1 = SETID послан, ждём
bool     asgBusy = false;     // машина назначений активна
uint32_t tAsg = 0;            // таймер фазы ожидания (400 мс после SETID)
String   asgRep = "";         // накопленный отчёт
uint8_t  asgAlive = 0, asgAssigned = 0;

String rpcNeuroAssign() {
  if (asgBusy) {
    return String("busy:") + asgIdx + "/" + NEURONS;
  }
  asgIdx = 0; asgPhase = 0; asgBusy = true;
  asgRep = ""; asgAlive = 0; asgAssigned = 0;
  HUB_OUT.println("[NET] neuro_assign: запущено (неблокирующе, v2.33)");
  return String("started");
}

String rpcNeuroAssignPoll() {
  return String("p:") + asgIdx + ";" + (asgBusy ? "busy" : "done") + ";" +
         asgRep;
}

void neuroAssignTick() {
  if (!asgBusy) return;
  if (asgPhase == 1) {
    if (millis() - tAsg < 400) return;      // плате дать перерегистрироваться
#if LINK_SW_WIRE
    uint8_t addr = I2C_BASE_ADDR + asgIdx;
    uint8_t got = NeuroBus.requestFrom(addr, (uint8_t)2);
    while (NeuroBus.available()) NeuroBus.read();
    if (got) { asgAssigned++; asgAlive++;
               asgRep += String(asgIdx) + ":НАЗНАЧЕН "; }
    else     { asgRep += String(asgIdx) + ":пусто "; }
#else
    /* серийный режим: канал адресный, SETID ушёл адресно — слот считается
     * назначенным (отчёт "ser"); точную живость покажет обычный опрос */
    asgAssigned++; asgAlive++;
    asgRep += String(asgIdx) + ":ser ";
#endif
    asgPhase = 0;
    asgIdx++;
    if (asgIdx >= NEURONS) {                // всё — печатаем итог
      asgBusy = false;
      HUB_OUT.print("[NET] neuro_assign: живых/назначено ");
      HUB_OUT.print(asgAlive); HUB_OUT.print("/");
      HUB_OUT.print(asgAssigned); HUB_OUT.print(" — ");
      HUB_OUT.println(asgRep);
    }
    return;
  }
  /* фаза 0: опросить слот; живой — пометить, молчащий — послать SETID */
  if (asgIdx >= NEURONS) { asgBusy = false; return; }
#if LINK_SW_WIRE
  uint8_t addr = I2C_BASE_ADDR + asgIdx;
  uint8_t got = NeuroBus.requestFrom(addr, (uint8_t)2);
  while (NeuroBus.available()) NeuroBus.read();
  if (got) { asgAlive++; asgRep += String(asgIdx) + ":занят "; asgIdx++; return; }
  String cmd = "SETID;" + String(asgIdx);   // ОБЩИЙ ВЫЗОВ (адрес 0)
  NeuroBus.beginTransmission(0x00);
  for (uint8_t k = 0; k < cmd.length(); k++)
    NeuroBus.write((uint8_t)cmd[k]);
  NeuroBus.endTransmission();
#else
  /* серийный режим: нейрон с пустым номером берёт "SETID;<n>" через
   * мультиплексор — канал адресуется индивидуально, конфликтов нет */
  setMux(asgIdx);
  NeuroSer.println("SETID;" + String(asgIdx));
#endif
  asgPhase = 1;                             // ждём 400 мс БЕЗ delay()
  tAsg = millis();
}

/* v2.29: СБРОС НОМЕРОВ (RPC neuro_reset -> отчёт строкой). Всем платам в
 * ОБЩИЙ ВЫЗОВ (адрес 0) уходит "CLR_ID": прошивка neuron_node v2.7 стирает
 * номер из EEPROM и снова слушает общий вызов («сирота», быстрое мигание
 * LED). Ручные платы (NEURON_ID 0..11 в коде) команду игнорируют. После
 * сброса подключайте платы ПО ОДНОЙ и запускайте neuro_assign («нейроны»). */
String rpcNeuroReset() {
#if LINK_SW_WIRE
  NeuroBus.beginTransmission(0x00);              // ОБЩИЙ ВЫЗОВ — слышат все
  NeuroBus.write((const uint8_t *)"CLR_ID", (uint8_t)6);
  NeuroBus.endTransmission();
  /* v2.33: delay(50) убран — обработчик Bridge обязан быть мгновенным;
   * I2C-передача сама завершается в endTransmission() */
#else
  /* серийный режим: "CLR_ID" через мультиплексор в каждый канал */
  for (uint8_t n = 0; n < NEURONS; n++) {
    setMux(n);
    NeuroSer.println("CLR_ID");
    delay(30);
  }
#endif
  HUB_OUT.println("[NET] neuro_reset: CLR_ID отправлен всем платам (общий вызов)");
  return "CLR_ID отправлен всем платам; теперь подключайте платы ПО ОДНОЙ "
         "и запускайте назначение («нейроны»)";
}

/* ============================================================================
 * v2.30: ПРИЁМНИК КАДРОВ КАМЕРЫ ПО UART (ESP32-CAM -> UNO Q, ПО ПРОВОДУ)
 * Камера (sketch/esp32cam_uart v1.0) шлёт JPEG-кадры форматом «буфера»:
 *   A5 5C | тип (1) | seq (1) | len (2, LE) | crc16/XMODEM (2, LE) | payload
 * Приём НЕБЛОКИРУЮЩИЙ: camUartTick() вызывается из loop() каждый раз,
 *   парсер-автомат пересинхронизируется по магии, кадры с неверным CRC
 *   отбрасываются (счётчик camBad) — поток переживает шум линии.
 * Целый JPEG хранится в camBuf (последний кадр) и отдаётся мозгу КУСКАМИ:
 *   RPC cam_frame_info -> "len=..;seq=..;ok=..;bad=..;age_ms=..;baud=.."
 *   RPC cam_chunk("seq:off") -> base64-кусок ("" — кадр уже сменился:
 *   мозг перечитает info). Лимит сообщения моста 8 КБ не нарушается.
 * ПОДКЛЮЧЕНИЕ: TX ESP32-CAM (GPIO13) -> RX Serial1 (D0), GND общий;
 *   SD-карту из ESP32-CAM вынуть (её пины 13/14). Скорость = CAM_BAUD
 *   скетча камеры. При LINK_SW_WIRE 0 Serial1 может быть занят нейронами
 *   (запасной вариант) — тогда камеру вешать на другой UART. */
#define CAMRX          Serial1   // аппаратный UART платы (D0/D1)
#define CAMRX_BAUD     460800    // = CAM_BAUD скетча камеры
#define CAMRX_BUF      20480     // v2.89.2: 2 буфера по 20 КБ = те же 40 КБ памяти, что до v2.88
                                 // (в v2.88 было 2×40 КБ — скетч мог не поместиться и не стартовать);
                                 // JPEG QVGA q12 — 6…15 КБ, кадр больше 20 КБ отбрасывается
#define CAMRX_CHUNK    768       // байт в base64-куске RPC cam_chunk

static uint8_t  camBuf[CAMRX_BUF]; // последний целый кадр
static uint8_t  camRx[CAMRX_BUF];  // v2.88: приём идёт сюда; в camBuf — только целый JPEG (20 КБ)
#define CAMVIS_MAX     1200      // v2.88: JSON зрения камеры (тип 0x03)
static char     camVis[CAMVIS_MAX] = "";
static uint32_t camVisMs = 0, camVisN = 0;
static char     camVote[320] = ""; // v2.88: JSON голоса камеры (тип 0x04)
static uint32_t camVoteN = 0;
static uint16_t camLen = 0;        // его длина
static uint8_t  camFrameSeq = 0;   // seq последнего целого кадра
static uint32_t camLastMs = 0;     // когда кадр положили
static uint32_t camOk = 0, camBad = 0;          // счётчики целых/битых
static volatile bool camCopying = false;   // v2.94.1: кадр копируется в camBuf
static volatile uint32_t camGen = 0;       // v2.94.1: счётчик смен кадра (чётный — кадр целый)
static uint32_t camBytes = 0;      // v2.93: сколько байт пришло по UART вообще (0 = провод/питание)
static uint32_t camByteMs = 0;     // v2.93: когда пришёл последний байт
static uint32_t camLost = 0;       // v2.93: пакеты, оборванные паузой (переполнение приёмника)
static uint8_t  camPkt[8];         // заголовок принимаемого кадра
static uint8_t  camPktGot = 0;
static uint16_t camPktLen = 0, camPktGotData = 0;
static uint8_t  camState = 0;      // 0=ищем A5, 1=ждём 5C, 2=заголовок, 3=payload

/* CRC16/XMODEM (полином 0x1021, старт 0) — та же формула, что у камеры */
static uint16_t camCrc16(const uint8_t *d, uint16_t n) {
  uint16_t crc = 0;
  while (n--) {
    crc ^= (uint16_t)(*d++) << 8;
    for (uint8_t k = 0; k < 8; k++)
      crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
  }
  return crc;
}

/* base64-кодер: кадр уезжает кусками по CAMRX_CHUNK байт -> 1024 символа */
static const char CAMB64[] =
  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

static String camB64(const uint8_t *d, int n) {
  String s;
  s.reserve(((n + 2) / 3) * 4);
  int i = 0;
  while (i + 2 < n) {
    uint32_t v = ((uint32_t)d[i] << 16) | ((uint32_t)d[i + 1] << 8) | d[i + 2];
    i += 3;
    s += CAMB64[(v >> 18) & 63];
    s += CAMB64[(v >> 12) & 63];
    s += CAMB64[(v >> 6) & 63];
    s += CAMB64[v & 63];
  }
  if (i < n) {                            // хвост 1-2 байта с добивкой '='
    uint32_t v = (uint32_t)d[i] << 16;
    if (i + 1 < n) v |= (uint32_t)d[i + 1] << 8;
    s += CAMB64[(v >> 18) & 63];
    s += CAMB64[(v >> 12) & 63];
    s += (i + 1 < n) ? CAMB64[(v >> 6) & 63] : '=';
    s += '=';
  }
  return s;
}

/* Неблокирующий приём байтов камеры — вызывать из loop() каждую итерацию */
void camUartTick() {
  /* v2.93: пакет оборвался (байты потеряны, пока loop был занят) — не ждём
   * его вечно, иначе съедим заголовок следующего кадра и испортим и его */
  if (camState >= 2 && (uint32_t)(millis() - camByteMs) > 60) { camState = 0; camLost++; }
  while (CAMRX.available()) {
    uint8_t b = (uint8_t)CAMRX.read();
    camBytes++; camByteMs = millis();
    if (camState == 0) {                  // сканируем магию A5 5C
      if (b == 0xA5) camState = 1;
    } else if (camState == 1) {
      if (b == 0x5C) { camState = 2; camPktGot = 0; }
      else camState = (b == 0xA5) ? 1 : 0;
    } else if (camState == 2) {           // добираем заголовок (ещё 6 байт)
      camPkt[camPktGot++] = b;
      if (camPktGot >= 8) {
        camPktLen = (uint16_t)camPkt[4] | ((uint16_t)camPkt[5] << 8);
        if (camPktLen == 0 || camPktLen > CAMRX_BUF) {
          camState = 0;
          camBad++;
        } else {
          camState = 3;
          camPktGotData = 0;
        }
      }
    } else {                              // payload кадра/статуса/зрения/голоса
      camRx[camPktGotData++] = b;
      if (camPktGotData >= camPktLen) {
        camState = 0;
        uint16_t crc = camCrc16(camRx, camPktLen);
        uint16_t want = (uint16_t)camPkt[6] | (uint16_t)((uint16_t)camPkt[7] << 8);
        if (crc != want) { camBad++; continue; }
        uint8_t typ = camPkt[2];
        if (typ == 0x01) {                // JPEG-кадр — целиком в camBuf
          if (camRx[0] == 0xFF && camRx[1] == 0xD8) {
            camCopying = true;                // v2.94.1: поток моста не читает кадр, пока копируем
            camGen++;
            memcpy(camBuf, camRx, camPktLen);
            camLen = camPktLen;
            camFrameSeq = camPkt[3];
            camGen++;
            camCopying = false;
            camLastMs = millis();
            camOk++;
          } else camBad++;                // не JPEG — в мусор
        } else if (typ == 0x03 && camPktLen < CAMVIS_MAX) {   // v2.88: зрение
          memcpy(camVis, camRx, camPktLen);
          camVis[camPktLen] = 0;
          camVisMs = millis();
          camVisN++;
        } else if (typ == 0x04 && camPktLen < sizeof(camVote)) { // v2.88: голос
          memcpy(camVote, camRx, camPktLen);
          camVote[camPktLen] = 0;
          camVoteN++;
        } else if (typ == 0x02) {         // текстовый статус камеры
          if (camPktLen < CAMRX_BUF) camRx[camPktLen] = 0;
          HUB_OUT.print("[CAM] ");
          HUB_OUT.println((const char *)camRx);
        }
      }
    }
  }
}

/* RPC cam_frame_info: параметры последнего кадра + счётчики (для мозга) */
String rpcCamFrameInfo() {
  if (!camLen)
    return "len=0;ok=" + String(camOk) + ";bad=" + String(camBad) +
           ";bytes=" + String(camBytes) + ";lost=" + String(camLost) +
           ";baud=" + String(CAMRX_BAUD);
  return "len=" + String(camLen) + ";seq=" + String(camFrameSeq) +
         ";ok=" + String(camOk) + ";bad=" + String(camBad) +
         ";age_ms=" + String(millis() - camLastMs) +
         ";baud=" + String(CAMRX_BAUD) +
         ";bytes=" + String(camBytes) + ";lost=" + String(camLost);
}

/* RPC cam_chunk("seq:off"): base64-кусок кадра; "" — кадр уже сменился
 * или аргумент кривой: мозг перечитает cam_frame_info и начнёт заново */
/* v2.88: КАМЕРА С НЕЙРОСЕТЬЮ (esp32cam_tflite) — слова выбираются вместе.
 * cam_vis()          -> "age_ms=N|{json зрения}" ("" — камера не присылала)
 * cam_vote("id|ф1|ф2|...") -> камере уходит строка V..., ответ — в cam_vote_res
 * cam_vote_res()     -> последний JSON голоса камеры ("" — ещё нет)
 * cam_say("фраза")   -> камере уходит W...: она учит слова со своей сценой */
/* ---------------- v2.94: VR3 — программный UART 9600 на D12/D13 ---------------- */
static volatile uint8_t  vrRing[256];
static volatile uint8_t  vrHead = 0, vrTail = 0;
static volatile uint32_t vrBytes = 0, vrErr = 0;
static uint8_t  vrFr[40];           // кадр AA | L | cmd | data | 0A (без AA и L)
static uint8_t  vrFrLen = 0, vrFrGot = 0, vrSt = 0;
static uint32_t vrFrMs = 0, vrFrames = 0;
static char     vrOut[600];         // готовые кадры hex через ';' (забирает vr_read)

static inline void vrWaitUntil(uint32_t t) { while ((int32_t)(micros() - t) < 0) {} }

void vrRxIsr() {
  if (digitalRead(VR_RX_PIN) != LOW) return;       // отложенный фронт внутри байта — не старт
  uint32_t t0 = micros();
  uint8_t b = 0;
  for (uint8_t i = 0; i < 8; i++) {                // середины бит: 1.5, 2.5 … 8.5 бита
    vrWaitUntil(t0 + VR_BIT_US + VR_BIT_US / 2 + (uint32_t)i * VR_BIT_US);
    if (digitalRead(VR_RX_PIN) == HIGH) b |= (uint8_t)(1u << i);
  }
  vrWaitUntil(t0 + 9u * VR_BIT_US + VR_BIT_US / 2);
  if (digitalRead(VR_RX_PIN) != HIGH) { vrErr++; return; }   // нет стоп-бита
  uint8_t n = (uint8_t)(vrHead + 1);
  if (n != vrTail) { vrRing[vrHead] = b; vrHead = n; }
  vrBytes++;
}

static void vrWriteByte(uint8_t b) {
  uint32_t t0 = micros();
  digitalWrite(VR_TX_PIN, LOW);
  vrWaitUntil(t0 + VR_BIT_US);
  for (uint8_t i = 0; i < 8; i++) {
    digitalWrite(VR_TX_PIN, ((b >> i) & 1) ? HIGH : LOW);
    vrWaitUntil(t0 + (uint32_t)(i + 2) * VR_BIT_US);
  }
  digitalWrite(VR_TX_PIN, HIGH);
  vrWaitUntil(t0 + 10u * VR_BIT_US);
}

static void vrFrameDone() {
  char hx[3 * 40 + 2];
  uint8_t k = 0;
  static const char H[] = "0123456789ABCDEF";
  for (uint8_t i = 0; i + 1 < vrFrGot && k + 3 < sizeof(hx); i++) {   // без хвоста 0A
    hx[k++] = H[vrFr[i] >> 4];
    hx[k++] = H[vrFr[i] & 15];
  }
  hx[k] = 0;
  size_t ol = strlen(vrOut);
  if (ol + k + 2 >= sizeof(vrOut)) { vrOut[0] = 0; ol = 0; }          // никто не забирал — с начала
  memcpy(vrOut + ol, hx, k);
  vrOut[ol + k] = ';';
  vrOut[ol + k + 1] = 0;
  vrFrames++;
}

void vrTick() {
  if (vrSt && (uint32_t)(millis() - vrFrMs) > 200) vrSt = 0;         // оборванный кадр
  while (vrTail != vrHead) {
    uint8_t b = vrRing[vrTail];
    vrTail = (uint8_t)(vrTail + 1);
    vrFrMs = millis();
    if (vrSt == 0) { if (b == 0xAA) vrSt = 1; }
    else if (vrSt == 1) {
      if (b < 2 || b > sizeof(vrFr)) { vrSt = (b == 0xAA) ? 1 : 0; continue; }
      vrFrLen = b; vrFrGot = 0; vrSt = 2;
    } else {
      vrFr[vrFrGot++] = b;
      if (vrFrGot >= vrFrLen) {
        if (b == 0x0A) vrFrameDone(); else vrErr++;
        vrSt = 0;
      }
    }
  }
}

/* RPC vr_enable("1"/"0") — включить/выключить приём VR3 на D12/D13 */
static bool vrOn = false;
String rpcVrEnable(String a) {
  bool want = a.length() && a[0] == '1';
  if (want == vrOn) return vrOn ? "on" : "off";
  if (want) {
    int irq = digitalPinToInterrupt(VR_RX_PIN);
    if (irq < 0) return "no-irq";
    pinMode(VR_TX_PIN, OUTPUT);
    digitalWrite(VR_TX_PIN, HIGH);
    pinMode(VR_RX_PIN, INPUT_PULLUP);
    attachInterrupt(irq, vrRxIsr, FALLING);
    vrOn = true;
    return "on";
  }
  detachInterrupt(digitalPinToInterrupt(VR_RX_PIN));
  vrOn = false;
  return "off";
}

/* RPC vr_read -> "b=<байт>;e=<ошибок>;f=<кадров>|HEX;HEX;" (кадры: cmd+data) */
String rpcVrRead() {
  vrTick();                          // v2.94.4: разбор кадров — здесь, в потоке моста
  String r = "b=" + String(vrBytes) + ";e=" + String(vrErr) + ";f=" + String(vrFrames) + "|" + String(vrOut);
  vrOut[0] = 0;
  return r;
}

/* RPC vr_send("HEX") — cmd+data; плата сама добавит AA, длину и 0A */
String rpcVrSend(String hex) {
  if (!vrOn) return "off";
  uint8_t buf[40];
  uint8_t n = 0;
  hex.trim();
  for (unsigned i = 0; i + 1 < hex.length() && n < sizeof(buf); i += 2) {
    char a = hex[i], c = hex[i + 1];
    auto v = [](char x) -> int { return x >= '0' && x <= '9' ? x - '0' : x >= 'a' && x <= 'f' ? x - 'a' + 10 : x >= 'A' && x <= 'F' ? x - 'A' + 10 : -1; };
    int hi = v(a), lo = v(c);
    if (hi < 0 || lo < 0) return "bad hex";
    buf[n++] = (uint8_t)(hi * 16 + lo);
  }
  if (!n) return "empty";
  vrWriteByte(0xAA);
  vrWriteByte((uint8_t)(n + 1));   // длина = cmd + data + 0A
  for (uint8_t i = 0; i < n; i++) vrWriteByte(buf[i]);
  vrWriteByte(0x0A);
  return "ok";
}

static void camLine(char cmd, String arg) {
  arg.replace("\n", " ");
  arg.replace("\r", " ");
  if (arg.length() > 700) arg = arg.substring(0, 700);
  CAMRX.print(cmd);
  CAMRX.print(arg);
  CAMRX.print('\n');
}

String rpcCamVis() {
  if (!camVisN) return "";
  return "age_ms=" + String(millis() - camVisMs) + "|" + String(camVis);
}

String rpcCamVote(String arg) {
  camVote[0] = 0;
  camLine('V', arg);
  return "ok";
}

String rpcCamVoteRes() { return String(camVote); }

String rpcCamSay(String arg) {
  camLine('W', arg);
  return "ok";
}

String rpcCamChunk(String arg) {
  int col = arg.indexOf(':');
  if (col <= 0) return "";
  long seq = arg.substring(0, col).toInt();
  long off = arg.substring(col + 1).toInt();
  uint32_t g0 = camGen;                       // v2.94.1: вызывается из потока моста
  if (camCopying || (g0 & 1) || seq != (long)camFrameSeq || camLen == 0 ||
      off < 0 || off >= (long)camLen) return "";
  int n = (int)camLen - (int)off;
  if (n > CAMRX_CHUNK) n = CAMRX_CHUNK;
  String r = camB64(camBuf + off, n);
  if (camGen != g0 || camCopying) return "";  // кадр сменился, пока читали — заново
  return r;
}

void wordInputs(int8_t *x) {
  x[0] = 100;                       // смещение
  x[1] = (int8_t)txtLevel;          // текст-канал (чат/свои слова/облако)
  x[2] = (int8_t)micLevel;          // звук
  x[3] = (int8_t)spkLvlLast;        // спайки нейронов
}

uint8_t wordPick(const int8_t *x) {
  int32_t best = -2000000000L; uint8_t bo = 0;
  for (uint8_t i = 0; i < WD_N; i++) {
    int32_t acc = (int32_t)wordW[i] * 4;
    for (uint8_t k = 0; k < 4; k++) acc += (int32_t)wordCtx[i][k] * x[k];
    acc = (acc >> 6) + (int32_t)(lcgNext() % 13) - 6;   // живость выбора
    if (acc > best) { best = acc; bo = i; }
  }
  if ((lcgNext() % 100) < 15) bo = (uint8_t)(lcgNext() % WD_N); // исследование
  return bo;
}

/* Учитель оценил фразу — подкрепляем и выбор последнего слова */
void wordTeach(int8_t reward) {
  if (!wordDecFresh || lastWordIdx >= WD_N) return;
  int32_t w = (int32_t)wordW[lastWordIdx] + (int32_t)reward * 2 * learningScale;
  if (w > 40) w = 40;
  if (w < -40) w = -40;
  wordW[lastWordIdx] = (int8_t)w;
  int8_t x[4];
  wordInputs(x);
  for (uint8_t k = 0; k < 4; k++) {
    int32_t v = (int32_t)wordCtx[lastWordIdx][k] + (int32_t)reward * x[k] / 24;
    if (v > 60) v = 60;
    if (v < -60) v = -60;
    wordCtx[lastWordIdx][k] = (int8_t)v;
  }
  wordDecFresh = false;
  wordsDirty = true;
}

void wordsSave() {
#if USE_EEPROM
  if (!wordsDirty) return;
  eePend |= 2;
#endif
  wordsDirty = false;
}

/* v2.67: один шаг записи EEPROM (см. eePend): не больше EE_STEP реальных
 * записей и не дольше ~2 мс проверок за проход loop(). */
void eePumpTick() {
#if USE_EEPROM
  if (!eeWhat) {
    if (eePend & 1) { eeWhat = 1; eePend &= ~1; eeCur = 0; }
    else if (eePend & 2) { eeWhat = 2; eePend &= ~2; eeCur = 0; }
    else return;
  }
  uint8_t budget = EE_STEP;
  uint32_t t0 = micros();
  while (budget && (micros() - t0) < 2000UL) {
    int addr; uint8_t v;
    if (eeWhat == 1) {
      const uint16_t n = NET_OUT * NET_IN;
      if (eeCur < n) { addr = NET_WADDR + eeCur; v = ((const uint8_t *)netW)[eeCur]; }
      else if (eeCur == n) { addr = NET_MAGIC_ADDR; v = NET_MAGIC; }
      else { eeWhat = 0; return; }
    } else {
      const uint16_t n1 = WD_N, n2 = WD_N * 5;
      if (eeCur < n1) { addr = WORD_WADDR + eeCur; v = ((const uint8_t *)wordW)[eeCur]; }
      else if (eeCur < n2) { addr = WORD_WADDR + eeCur; v = ((const uint8_t *)wordCtx)[eeCur - n1]; }
      else if (eeCur == n2) { addr = WORD_MAGIC_ADDR; v = WORD_MAGIC; }
      else { eeWhat = 0; return; }
    }
    if (EEPROM.read(addr) != v) { EEPROM.write(addr, v); budget--; }
    eeCur++;
  }
#endif
}

bool wordsLoad() {
#if USE_EEPROM
  if (EEPROM.read(WORD_MAGIC_ADDR) != WORD_MAGIC) return false;
  uint8_t *p = (uint8_t *)wordW;
  for (uint16_t k = 0; k < WD_N; k++) p[k] = EEPROM.read(WORD_WADDR + k);
  p = (uint8_t *)wordCtx;
  for (uint16_t k = 0; k < WD_N * 4; k++)
    p[k] = EEPROM.read(WORD_WADDR + WD_N + k);
  return true;
#else
  return false;
#endif
}

/* Подкрепление от учителя: reward = +1/-1 на решения фразы */
void netTeach(int8_t reward) {
  LetterDec *buf = decisions; uint8_t n = decCount;
  if (lastDecFresh && lastDecCount) { buf = lastDec; n = lastDecCount; }
  if (!n) return;
  for (uint8_t d = 0; d < n; d++) {
    uint8_t ch = buf[d].ch; if (ch >= NET_OUT) continue;
    for (uint8_t i = 0; i < NET_IN; i++) {
      int32_t w = (int32_t)netW[ch][i] + (int32_t)reward * buf[d].x[i] / 24 * learningScale;
      if (w > 90) w = 90;
      if (w < -60) w = -60;
      netW[ch][i] = (int8_t)w;
    }
  }
  if (buf == lastDec) lastDecFresh = false;  // оценку получили — память свободна
  netDirty = true;
  netSave();
  wordTeach(reward);                  // v2.26: и выбор слова — тоже
  teachCount++;
  HUB_OUT.print("[NET] учитель: ");
  HUB_OUT.print(reward > 0 ? "+1 награда" : "-1 наказание");
  HUB_OUT.print(" (решений: "); HUB_OUT.print((unsigned)n); HUB_OUT.println(")");
}

/* ---------------- ТОЧЕЧНОЕ ОБУЧЕНИЕ (v2.6): кредит за букву --------------
 * Проблема netTeach: ОДНА оценка ±1 размазывается по ВСЕМ буквам фразы —
 * хорошие буквы наказываются вместе с плохими. Поэтому «оценки не работают».
 * v2.6 добавляет два точных метода (мозг вызывает их по мосту):
 *   teach_last(+1/-1)  — мгновенное подкрепление ПОСЛЕДНЕГО решения
 *                        (диктант: каждая буква сравнивается с целью);
 *   teach_shape("++-·+") — своя награда КАЖДОМУ решению запечатанной фразы
 *                        ('+' = +1, '-' = -1, прочее = пропуск);
 * teach_score(±1) остаётся как «глобальное мнение учителя».                   */
void netTeachOne(int8_t *x, uint8_t ch, int8_t reward) {
  if (ch >= NET_OUT) return;
  for (uint8_t i = 0; i < NET_IN; i++) {
    int32_t w = (int32_t)netW[ch][i] + (int32_t)reward * x[i] / 24 * learningScale;
    if (w > 90) w = 90;
    if (w < -60) w = -60;
    netW[ch][i] = (int8_t)w;
  }
  netDirty = true;
}

void rpcTeachLast(int reward) {
  if (!decCount) return;
  netTeachOne(decisions[decCount - 1].x, decisions[decCount - 1].ch,
              reward >= 0 ? 1 : -1);
  teachCount++;
  netSave();
}

void rpcTeachShape(String mask) {
  LetterDec *buf = decisions; uint8_t n = decCount;
  if (lastDecFresh && lastDecCount) { buf = lastDec; n = lastDecCount; }
  if (!n) return;
  uint8_t m = (mask.length() < (unsigned)n) ? (uint8_t)mask.length() : n;
  uint8_t hits = 0, pl = 0, mn = 0;
  for (uint8_t d = 0; d < m; d++) {
    char c = mask[d];
    if (c == '+') { netTeachOne(buf[d].x, buf[d].ch, 1); hits++; pl++; }
    else if (c == '-') { netTeachOne(buf[d].x, buf[d].ch, -1); hits++; mn++; }
    /* прочие символы — решение не трогаем */
  }
  /* v2.26: маска учителя подкрепляет и выбор слова (знак по большинству) */
  if (pl > mn) wordTeach(1);
  else if (mn > pl) wordTeach(-1);
  teachCount++;
  netSave();
  HUB_OUT.print("[NET] маска учителя: "); HUB_OUT.print(mask);
  HUB_OUT.print(" (изменений: "); HUB_OUT.print((unsigned)hits);
  HUB_OUT.print("/"); HUB_OUT.print((unsigned)n); HUB_OUT.println(")");
}

/* --------------------- СБОРКА СЛОВ И ФРАЗ (v2.3) ------------------------- */
void appendGenC(uint8_t num, const char *tok) {
  char item[14];
  snprintf(item, sizeof(item), "G%u:%s|", num, tok);
  uint16_t used = (uint16_t)strlen(val_c);
  if (used + strlen(item) >= VAL_C_SIZE - 1) {
    uint16_t cut = strlen(item);
    memmove(val_c, val_c + cut, used - cut + 1);
    used = (uint16_t)strlen(val_c);
  }
  strlcpy(val_c + used, item, VAL_C_SIZE - used);
}

void genSentAppend(const char *tok) {
  uint8_t bl = (uint8_t)strlen(tok);
  if (genSentLenB + bl >= sizeof(genSent) - 1) return;
  memcpy(genSent + genSentLenB, tok, bl);
  genSentLenB += bl; genSent[genSentLenB] = 0;
  genSentChars++;
}

/* v2.38: прижать знак к слову — убрать ХВОСТОВОЙ пробел фразы (после
 * сказанного слова фраза всегда кончается пробелом; знак должен дать
 * «СЛОВО,» и «СЛОВО.», а не «СЛОВО ,» / «СЛОВО .»). */
void genSentTrimSpace() {
  if (genSentLenB && genSent[genSentLenB - 1] == ' ') {
    genSent[--genSentLenB] = 0;
    if (genSentChars) genSentChars--;
  }
}

void decSeal() {   // фраза завершена: её решения ждут оценки учителя
  memcpy(lastDec, decisions, sizeof(LetterDec) * decCount);
  lastDecCount = decCount;
  lastDecFresh = true;
}

/* Слова уходят платам-нейронам как стимул: "STIM;<слово>" (код нейронов
 * НЕ менялся: стимул хешируется в входы перцептронов 3 секунды) */
void broadcastStimWord(const char *w) {
  char stim[36];
  snprintf(stim, sizeof(stim), "STIM;%.28s", w);
  utf8Fix(stim);   /* v2.24: %.28s резал по байтам — нейрону не сеем битую
                    * букву, иначе он возвращает её в словах вечно */
#if LINK_SW_WIRE
  for (uint8_t i = 0; i < NEURONS; i++) {
    NeuroBus.beginTransmission((uint8_t)(I2C_BASE_ADDR + i));
    NeuroBus.write((const uint8_t *)stim, (uint8_t)min((size_t)31, strlen(stim)));
    NeuroBus.endTransmission();
  }
#else
  NeuroSer.print(stim); NeuroSer.print('\n');
#endif
}

/* Слово готово: в фразе, в мелодию D8, нейронам стимулом */
/* v2.85: отсев «ахинеи» буквенной сети. Настоящее русское слово почти
 * всегда содержит гласную; три+ согласных подряд и повтор одной буквы
 * — признак лепета («ИЧИИЕИФИИЪ»). Если слово не из словаря и выглядит
 * как лепет — подменяем его случайным словом из WDICT, чтобы нейроны
 * помогали собирать связный текст, а не шум. */
bool wordLooksReal(const char *w) {
  if (!w || !w[0]) return false;
  uint8_t vowels = 0, consRun = 0, maxRun = 0, same = 0, last = 255, n = 0;
  for (uint8_t p = 0; w[p] && w[p + 1] && n < WORD_MAX; p += 2) {
    uint8_t num = letterNumOf(w + p);
    if (!num) return false;
    n++;
    uint8_t li = num - 1;
    if (RU_VOW[li]) { vowels++; consRun = 0; }
    else { consRun++; if (consRun > maxRun) maxRun = consRun; }
    if (li == last) same++; else same = 1;
    if (same >= 3) return false;                 // «ИИИ», «ААА»
    last = li;
  }
  if (n < 2) return true;                        // «Я», «ТЫ» и т.п.
  if (!vowels) return false;                     // одни согласные
  if (maxRun >= 4) return false;                 // «ЧЧЧЧ», «ШШШШ»
  return true;
}

void wordCommit(char tail) {
  if (!genWordLen) return;
  /* v2.85: буквенный лепет, не похожий на слово, не отдаём нейронам */
  if (dictCur == 255 && !wordLooksReal(genWord)) {
    uint8_t wi = (uint8_t)(lcgNext() % WD_N);
    strlcpy(genWord, WDICT[wi], sizeof(genWord));
    genWordLen = (uint8_t)strlen(genWord);
    HUB_OUT.print("[GEN] лепет заменён словарным: ");
    HUB_OUT.println(genWord);
  }
  if (tail) { char t[2] = {tail, 0}; genSentAppend(t); }
  wordsMade++;
  voiceWord(genWord);              // произношение слова динамиком (ноты)
  broadcastStimWord(genWord);      // слово — стимул для 12 плат-нейронов
  txtBump(14);                     // своё слово — текст-канал жив
  /* v2.22: на D6 идёт БУФЕР СЛОВА (его байты + хвост), а не номер буквы;
   * если играет фраза мозга (d6seq) — своё слово не подмешиваем.       */
  if (!d6Len) {
    char wb[WORD_MAX * 2 + 4];
    snprintf(wb, sizeof(wb), "%s%c", genWord, tail ? tail : ' ');
    d6PutText(wb);
  }
#if USE_RB
  Bridge.notify("on_word", String(genWord));   /* слово готово */
#endif
  genWordLen = 0; genWord[0] = 0;
}

/* Фраза завершена точкой: в итоговый буфер (SAY=), решения — учителю */
void sentenceDone() {
  if (genSentLenB) {
    uint8_t cut = (uint8_t)(SAY_MAX * 2);
    if (cut >= sizeof(sayBuf)) cut = sizeof(sayBuf) - 1;
    if (genSentLenB < cut) cut = genSentLenB;
    if (cut && (((uint8_t)genSent[cut - 1] == 0xD0) ||
                ((uint8_t)genSent[cut - 1] == 0xD1))) cut--;   // не рвать UTF-8
    memcpy(sayBuf, genSent, cut); sayBuf[cut] = 0;
    sentMade++;
    decSeal();
    HUB_OUT.print("[SAY] \""); HUB_OUT.print(sayBuf); HUB_OUT.println("\"");
  }
#if USE_RB
  if (sayBuf[0]) Bridge.notify("on_say", String(sayBuf));  /* фраза в буфере */
#endif
  genSentLenB = 0; genSent[0] = 0; genSentChars = 0;
  decCount = 0; afterPunct = false;
}

/* Частотный тег буквы: номер буквы 1..33 кладётся В ПОЛОСУ шины D4->A0 —
 * платы-нейроны слышат его своей пластикой (код нейронов не меняется).
 * Резервный цифровой канал "GEN;<тег>" несёт то же число.                 */
void letterPulse(uint8_t num) {
  uint16_t span = (cfgMaxHz > cfgMinHz + 40) ? (cfgMaxHz - cfgMinHz - 20) : 100;
  pulseHz = cfgMinHz + 10 + (uint16_t)((uint32_t)num * span / 33);
  if (pulseHz > cfgMaxHz) pulseHz = cfgMaxHz;
  pulseUntil = millis() + GEN_PULSE_MS;
  char g[16];
  snprintf(g, sizeof(g), "GEN;%u", pulseHz);
#if LINK_SW_WIRE
  for (uint8_t i = 0; i < NEURONS; i++) {
    NeuroBus.beginTransmission((uint8_t)(I2C_BASE_ADDR + i));
    NeuroBus.write((const uint8_t *)g, (uint8_t)strlen(g));
    NeuroBus.endTransmission();
  }
#else
  NeuroSer.print(g); NeuroSer.print('\n');
#endif
}

/* ШАГ ГЕНЕРАТОРА: нейросеть выбирает класс, механика собирает слова */
/* v2.26: ОДИН ШАГ СЛОВАРНОГО СЛОВА: буква за шагом — через ОБЫЧНЫЙ
 * конвейер (решения учителю, частотный тег буквы нейронам, val_c, D6,
 * мелодия D8). Слово взято из WDICT — лепета в готовых словах нет. */
void dictLetterTick() {
  const char *w = (dictSrc == 1) ? wordCur : WDICT[dictCur];   // v2.27
  uint8_t pair = (uint8_t)(dictPos * 2);
  int8_t x[NET_IN];
  netInputs(x);
  if (!w[pair] || genWordLen + 2 > sizeof(genWord) - 1) {
    /* слово кончилось — пробел, слово «сказано» */
    lastClass = CL_SPACE;
    curLetterNum = 0;
    strlcpy(curChr, "_", sizeof(curChr));
    wordCommit(' ');
    dictCur = 255; dictPos = 0; dictSrc = 0;   // v2.27
    lettersMade++;
    /* после слова — иногда точка: фразы естественной длины (2-6 слов) */
    if ((genSentChars >= SENT_MIN && (lcgNext() % 100) < 25) ||
        genSentChars >= SENT_MAX) {
      genSentTrimSpace();                    // v2.38: «СЛОВО.», не «СЛОВО .»
      genSentAppend(".");
      lastClass = CL_DOT;
      curLetterNum = 0;
      strlcpy(curChr, ".", sizeof(curChr));
      sentenceDone();
    }
    return;
  }
  uint8_t num = letterNumOf(w + pair);
  if (!num) { dictCur = 255; dictPos = 0; dictSrc = 0; return; }   // страховка
  dictPos++;
  lastClass = (uint8_t)(num - 1);
  curLetterNum = num;
  strlcpy(curChr, RU33[num - 1], sizeof(curChr));
  if ((size_t)genWordLen + 2 < sizeof(genWord)) {
    genWord[genWordLen++] = RU33[num - 1][0];
    genWord[genWordLen++] = RU33[num - 1][1];
    genWord[genWordLen] = 0;
  }
  genSentAppend(RU33[num - 1]);
  afterPunct = false;
  appendGenC(num, RU33[num - 1]);            // генератор живёт в val_c
  letterPulse(num);                          // номер буквы — в частоту шины
  /* решение для учителя — как у буквенной сети (кольцо DEC_MAX) */
  if (decCount < DEC_MAX) {
    memcpy(decisions[decCount].x, x, NET_IN);
    decisions[decCount].ch = (uint8_t)(num - 1);
    decCount++;
  } else {
    memmove(decisions, decisions + 1, sizeof(LetterDec) * (DEC_MAX - 1));
    memcpy(decisions[DEC_MAX - 1].x, x, NET_IN);
    decisions[DEC_MAX - 1].ch = (uint8_t)(num - 1);
  }
  lettersMade++;
}

/* v2.38: ЗНАК ОТ МОЗГА ИЗ ОЧЕРЕДИ СЛОВ. Знаки (",", ".", "!", "?") —
 * ЗАПИСИ СЛОВАРЯ (ru_top.json): мозг выбирает их сэмплером и присылает
 * word_push, как слова. Знак попадает во фразу той же механикой, что
 * знаки буквенной сети: запятая — между словами (", "), точка/!/ ? —
 * завершают фразу (SAY/D6-буфер уже наполнили слова; знак виден в
 * [SAY] и on_say, решение on_letter уходит в мост). СЕТЬ БУКВ НЕ
 * ТРОНУТА: веса 10x36, 36 выходов и решения учителю — как были; знак
 * сеть НЕ выбирала, поэтому в кольцо решений он не попадает.
 * Знак приходит ТОЛЬКО при пустом слове (очередь разбирается при
 * genWordLen == 0), поэтому wordCommit для знака не нужен. */
void boardMarkTick(char m) {
  if (m != ',' && m != '.' && m != '!' && m != '?') return;
  char s[2] = {m, 0};
  curLetterNum = 0;
  strlcpy(curChr, s, sizeof(curChr));
  lettersMade++;
  if (m == ',') {                            /* --- ЗАПЯТАЯ --- */
    if (genSentChars <= 0) return;           // запятая не бывает первой
    if (genSentChars >= SENT_MAX - 3) {      // не успевает — как у сети
      m = '.';
      s[0] = '.';                            // знак сменился — строка тоже
      strlcpy(curChr, s, sizeof(curChr));
    } else {
      genSentTrimSpace();                    // «СЛОВО ,» недопустимо
      genSentAppend(",");
      genSentAppend(" ");                    // пробел после запятой — сразу
      lastClass = CL_COMMA;
      /* afterPunct НЕ ставим: пробел уже вставлен, а если сеть следующим
       * шагом выберет свой пробел (после запятой она к нему расположена,
       * netW[CL_SPACE][9]), флаг дал бы ДВОЙНОЙ пробел во фразе. */
      Bridge.notify("on_letter", (int)0, String(curChr));
      return;
    }
  }
  /* --- ТОЧКА / «!» / «?» — конец фразы (как CL_DOT) --- */
  if (genSentChars < SENT_MIN) return;       // фраза коротка — знак мимо
  genSentTrimSpace();                        // знак прижат к слову
  genSentAppend(s);
  sentenceDone();
  lastClass = CL_DOT;                        // ! и ? ведут себя как точка
  Bridge.notify("on_letter", (int)0, String(curChr));
}

void letterTick() {
  if (millis() - tLetter < LETTER_TICK_MS) return;
  tLetter = millis();
  if (netDirty && millis() - netSaveAt > 30000) { netSaveAt = millis(); netSave(); }
  if (wordsDirty && millis() - wordsSaveAt > 30000) { wordsSaveAt = millis(); wordsSave(); }

  /* v2.27: словарное слово в процессе (WDICT или wordCur от мозга) —
   * идём по буквам через конвейер */
  if (dictCur != 255) { dictLetterTick(); return; }

  /* v2.86: ПРИОРИТЕТ — слово из большого словаря (ru_top.json, 30 000
   * слов, присылает Python word_pump). Локальные 64 слова и буквенный
   * лепет — только если очередь пуста уже долго (мозг не успевает). */
  if (genWordLen == 0 && lastClass >= CL_SPACE) {
    if (wordQCnt > 0) {
      strlcpy(wordPush, wordQ[wordQTail], sizeof(wordPush));
      wordQTail = (uint8_t)((wordQTail + 1) % WQ_N);
      wordQCnt--;
      if (wordPush[0] && !wordPush[1] && strchr(",.!?", wordPush[0])) {
        char m = wordPush[0];
        wordPush[0] = 0;
        boardMarkTick(m);
        return;
      }
      int8_t wi = wdictFind(wordPush);
      if (wi >= 0) {
        dictCur = (uint8_t)wi;
        dictSrc = 0;
        lastWordIdx = (uint8_t)wi;
        wordDecFresh = true;
      } else {
        strlcpy(wordCur, wordPush, sizeof(wordCur));
        dictSrc = 1;
        dictCur = 254;               // 254 = слово из wordCur (большой словарь)
        lastWordIdx = 255;
        wordDecFresh = false;
      }
      wordPush[0] = 0;
      dictPos = 0;
      wordsPicked++;
      return;
    }
    /* очередь пуста: ждём слово из 30 000. Локальный словарь — только
       если пусто уже > 1.5 с (мозг не успевает прислать). */
    static uint32_t tQEmpty = 0;
    if (!tQEmpty) tQEmpty = millis();
    if (millis() - tQEmpty < 1500) return;   // ждём word_pump
    tQEmpty = 0;
    if ((int)(lcgNext() % 100) < 80) {       // даже тогда — чаще словарь
      int8_t wx[4];
      wordInputs(wx);
      dictCur = wordPick(wx);
      dictPos = 0;
      lastWordIdx = dictCur;
      wordDecFresh = true;
      wordsPicked++;
      return;
    }
  }

  int8_t x[NET_IN];
  netInputs(x);
  uint8_t ch = netPick(x);

  /* --- механика сборки: отклонённый выбор заменяем допустимым --- */
  if (ch < 33) {
    if (genWordLen >= WORD_MAX * 2) ch = CL_SPACE;      // слово полное
  } else if (ch == CL_SPACE) {
    if (!genWordLen && !afterPunct) return;             // без двойных пробелов
  } else if (ch == CL_COMMA) {
    if (genSentChars >= SENT_MAX - 3) ch = CL_DOT;      // не успевает — точка
    else if (!genWordLen) return;                       // запятая только после слова
  } else if (ch == CL_DOT) {
    if (genSentChars < SENT_MIN) { if (genWordLen) ch = CL_SPACE; else return; }
  }

  /* запоминаем решение для учителя (кольцо: держим хвост фразы) */
  if (decCount < DEC_MAX) {
    memcpy(decisions[decCount].x, x, NET_IN);
    decisions[decCount].ch = ch; decCount++;
  } else {
    memmove(decisions, decisions + 1, sizeof(LetterDec) * (DEC_MAX - 1));
    memcpy(decisions[DEC_MAX - 1].x, x, NET_IN);
    decisions[DEC_MAX - 1].ch = ch;
  }
  lettersMade++;
  lastClass = ch;

  if (ch < 33) {                               /* --- БУКВА 1..33 --- */
    curLetterNum = ch + 1;
    strlcpy(curChr, RU33[ch], sizeof(curChr));
    if ((size_t)genWordLen + 2 < sizeof(genWord)) {
      genWord[genWordLen++] = RU33[ch][0];
      genWord[genWordLen++] = RU33[ch][1];
      genWord[genWordLen] = 0;
    }
    genSentAppend(RU33[ch]);
    afterPunct = false;
    appendGenC(curLetterNum, RU33[ch]);        // генератор живёт в val_c
    letterPulse(curLetterNum);                 // номер буквы — в частоту шины
    /* v2.19: буквы/слова больше НЕ печатаются в Serial (человек не должен
     * видеть «мысли» генератора): буква уходит в частотную шину, на D6
     * и в мост (on_letter) для обучения — но не на экран. */
  } else if (ch == CL_SPACE) {                 /* --- ПРОБЕЛ --- */
    curLetterNum = 0; strlcpy(curChr, "_", sizeof(curChr));
    if (afterPunct) { genSentAppend(" "); afterPunct = false; }
    else wordCommit(' ');
  } else if (ch == CL_COMMA) {                 /* --- ЗАПЯТАЯ --- */
    curLetterNum = 0; strlcpy(curChr, ",", sizeof(curChr));
    wordCommit(',');
    afterPunct = true;
  } else {                                     /* --- ТОЧКА --- */
    curLetterNum = 0; strlcpy(curChr, ".", sizeof(curChr));
    wordCommit('.');
    sentenceDone();
  }
  if (genSentChars >= SENT_MAX) { wordCommit('.'); sentenceDone(); }
  /* v2.22: номера букв на D6 больше НЕ выходят — пин несёт БУФЕР СЛОВ
   * (байты текста из wordCommit / d6seq), см. d6PutText и d6Tick. */
#if USE_RB
  Bridge.notify("on_letter", (int)curLetterNum, String(curChr));
#endif
}

/* v2.22: ПРОИГРЫВАНИЕ БУФЕРА СЛОВ НА D6: по БАЙТУ за D6_STEP_MS
 * (PWM = значение байта 0..255). По окончании пишем 0 — тишина до
 * следующего слова/фразы. */
void d6ImgTick() {
  if ((int32_t)(millis() - d6SlotMs) < 0) return;
  d6SlotMs = millis() + D6_STEP_MS;
  unsigned out = 0;
  uint8_t pxSlot = d6ImgNeg ? 3 : 1;
  if (d6Ph == 0) {                      // слот мысли
    if (d6Len && d6Pos < d6Len) {
      out = (unsigned)(uint8_t)d6Txt[d6Pos++];
      if (d6Pos >= d6Len) d6Len = 0;
    } else {
      d6Len = 0;
      if (d6FramePend && d6FrPos >= 4) { d6FramePend = false; d6FrPos = 0; }
      if (d6FrPos < 3) out = d6Frame[d6FrPos++];
      else if (d6FrPos == 3) d6FrPos = 4;
    }
  } else if (d6Ph == pxSlot) {          // слот точки кадра
    out = d6ImgTok(d6ImgIdx++);
  }
  analogWrite(NN_OUT_PIN, out);
  if (++d6Ph >= 4) {
    d6Ph = 0;
    if (d6ImgIdx >= D6_IMG_LEN) { d6ImgRun = false; analogWrite(NN_OUT_PIN, 0); }
  }
}

/* v2.93: раньше 8 analogRead на КАЖДЫЙ проход loop — АЦП Zephyr медленный,
 * и UART камеры (460800 бод, маленький приёмный буфер) за это время
 * переполнялся: кадры приходили битыми и не доходили до облака. Теперь одна
 * выборка раз в 4 мс, размах считается по окну из 8 выборок (~32 мс). */
static uint16_t capMn = 1023, capMx = 0;
static uint8_t  capN = 0;
static uint32_t capNextMs = 0;
void sampleCapNoise() {
  uint32_t now = millis();
  if ((int32_t)(now - capNextMs) < 0) return;
  capNextMs = now + 4;
  uint16_t v = analogRead(CAP_NOISE_PIN);
  if (v < capMn) capMn = v;
  if (v > capMx) capMx = v;
  if (++capN < 8) return;
  uint16_t span = capMx - capMn;
  capNoise = (uint8_t)min(255U, span / 2);   // грубая нормализация
  capMn = 1023; capMx = 0; capN = 0;
}

void noiseAsStim() {
  if (capNoise < 30) return;                 // порог
  uint32_t now = millis();
  if ((int32_t)(now - noiseStimMs) < 400) return;  // не чаще 2.5 Гц
  noiseStimMs = now;
  /* Стимул нейронам: чем сильнее шум — тем «ярче» слово-стимул */
  char stim[20];
  if (capNoise > 120) snprintf(stim, sizeof(stim), "STIM;NOISEHI");
  else if (capNoise > 60) snprintf(stim, sizeof(stim), "STIM;NOISE");
  else snprintf(stim, sizeof(stim), "STIM;NOISELO");
  camUartTick();                             // v2.93: UART камеры не ждёт I2C
  broadcastStimWord(stim + 5);               // без префикса, функция сама добавляет
  camUartTick();
#if USE_RB
  /* v2.93: три RPC в Linux — не чаще раза в секунду (было 2.5 Гц) */
  static uint32_t noiseNotifyMs = 0;
  if ((int32_t)(now - noiseNotifyMs) >= 1000) {
    noiseNotifyMs = now;
    Bridge.notify("cap_noise", (int)capNoise);
    camUartTick();
    Bridge.notify("d6_act", (int)d6Activity);
    camUartTick();
    Bridge.notify("learn_scale", (int)learningScale);
  }
#endif
  /* Временный подъём частоты генератора — нейроны сильнее пластичны */
  if (genHz < GEN_MAX_HZ - 100) genHz += 40;
}

void updateLearningScale() {
  /* d6Activity растёт от particleTick и d6 PWM, спадает сам */
  if (d6Activity > 0) d6Activity--;
  uint16_t eff = (uint16_t)capNoise + d6Activity;
  if (eff > 180) learningScale = 4;
  else if (eff > 100) learningScale = 3;
  else if (eff > 40) learningScale = 2;
  else learningScale = 1;
}

void particleTick() {
  if (!(partGrav || partMuon || partPhot)) return;
  uint32_t now = millis();
  if ((int32_t)(now - partNextMs) < 0) return;
  partNextMs = now + 80;   // ~12.5 Гц кванты
  uint8_t level = 0;
  if (partPhot && (partPhase % 5 == 0)) level = 220;          // короткая вспышка фотона
  else if (partMuon && (partPhase % 3 == 0)) level = 140;     // пакет мюона
  else if (partGrav) level = 40 + (partPhase % 20);           // низкий фон гравитона
  if (level) { analogWrite(NN_OUT_PIN, level); d6Activity = min(255, d6Activity + 8); }
  partPhase++;
}

void d6Tick() {
  if (d6PureTick(d6Len > 0 || d6FramePend || d6FrPos < 4)) return;   // v2.49
  if (d6ImgRdy && !d6ImgRun) {          // принятый кадр -> развёртка
    memcpy(d6Img, d6ImgIn, D6_IMG_N);
    d6ImgNeg = d6ImgInNeg; d6ImgRdy = false;
    d6ImgRun = true; d6ImgIdx = 0; d6Ph = 0; d6SlotMs = 0;
  }
  if (d6ImgRun) { d6ImgTick(); return; }
  if (!d6Len) {
    if (d6FramePend && d6FrPos >= 4) {          // текст кончился — кадр
      d6FramePend = false;
      d6FrPos = 0; d6NextMs = 0;
    }
    if (d6FrPos < 4) {
      if ((int32_t)(millis() - d6NextMs) < 0) return;
      analogWrite(NN_OUT_PIN, d6FrPos < 3 ? (unsigned)d6Frame[d6FrPos] : 0u);
      d6FrPos++;
      d6NextMs = millis() + D6_STEP_MS;
    }
    return;
  }
  if (d6Pos >= d6Len) {
    analogWrite(NN_OUT_PIN, 0);
    d6Len = 0;
    return;
  }
  if ((int32_t)(millis() - d6NextMs) < 0) return;
  analogWrite(NN_OUT_PIN, (unsigned)(uint8_t)d6Txt[d6Pos++]);
  d6NextMs = millis() + D6_STEP_MS;
}

/* ----------------------------- ГЕНЕРАТОР ЧАСТОТЫ ------------------------- */
/* Меандр на GEN_PIN с догоняющим планировщиком: даже после долгой блокировки
 * (опрос нейронов, мост) средняя частота на шине остаётся равной genHz —
 * нейроны считают фронты за окно и получают точное значение.                */
void freqTick() {
  if (genHz < 20 || d4fRun) return;     // v2.50: идёт кадр на D4
  uint32_t perUs = 1000000UL / genHz;
  uint32_t highUs = perUs / 2;                          // v2.48: полярность D4
  if (d4Pol > 0) highUs = perUs / 3;
  else if (d4Pol < 0) highUs = perUs * 2 / 3;
  uint32_t lowUs = perUs - highUs;
  if ((int32_t)(micros() - nextEdgeUs) < 0) return;
  uint8_t guard = 0;
  do {
    genOut = !genOut;
    digitalWrite(GEN_PIN, genOut ? HIGH : LOW);
    nextEdgeUs += genOut ? highUs : lowUs;
  } while (++guard < 200 && (int32_t)(micros() - nextEdgeUs) >= 0);
  if (guard >= 200) nextEdgeUs = micros();   // после длинного простоя — ресинхронизация
}

/* ----------------------------- ОПРОС НЕЙРОНОВ ---------------------------- */
void notePacket(uint8_t id, uint32_t spikes, const char *word) {
  if (id >= NEURONS) return;
  ns[id].spikes = spikes;
  /* v2.26: alive ставит ВЫЗЫВАЮЩИЙ (по факту ответа АДРЕСА) — данные же
   * пишутся в слот того номера, который нейрон сообщил сам (real). */
  strlcpy(ns[id].word, word, TEXT_MAX + 1);
  sanitize(ns[id].word);
}

/* Добавляем реплику нейрона в val_c: "N5:1042:сигнал|" */
void appendValC(uint8_t id, uint32_t spikes, const char *word) {
  char item[TEXT_MAX + 24];
  snprintf(item, sizeof(item), "N%u:%lu:%s|", id, (unsigned long)spikes, word);
  uint16_t used = (uint16_t)strlen(val_c);
  if (used + strlen(item) >= VAL_C_SIZE - 1) {   // вытесняем начало
    uint16_t cut = strlen(item);
    memmove(val_c, val_c + cut, used - cut + 1);
    used = (uint16_t)strlen(val_c);
  }
  strlcpy(val_c + used, item, VAL_C_SIZE - used);
}

/* Частота генератора -> платам-нейронам (резервный цифровой канал).
 * Основной канал — сама частота на проводе D4->A0: нейрон считает фронты.
 * "GEN;<hz>" остаётся для калибровки и на случай тихой шины.               */
void broadcastGen() {
  char g[16];
  snprintf(g, sizeof(g), "GEN;%u", genHz);
#if LINK_SW_WIRE
  for (uint8_t i = 0; i < NEURONS; i++) {
    NeuroBus.beginTransmission((uint8_t)(I2C_BASE_ADDR + i));
    NeuroBus.write((const uint8_t *)g, (uint8_t)strlen(g));
    NeuroBus.endTransmission();
  }
#else
  NeuroSer.print(g); NeuroSer.print('\n');   // услышит текущий канал мультиплексора
#endif
}

/* Кэш/буфер облака -> платам-нейронам: "BUF;<фрагмент>" (v1.3). Нейроны
 * воспринимают сводку облака как свежий внешний сигнал (вспышка LED).
 * ВАЖНО: cloud_buf уже санитизирован при приёме — sanitize() здесь НЕ
 * применяется, иначе он превратит разделитель ";" в ",".                */
void broadcastBuf() {
  txtBump(10);                         // облако «сказало» слово — текст-канал жив
  char b[30];
  snprintf(b, sizeof(b), "BUF;%.24s", cloud_buf);
  utf8Fix(b);                          /* v2.24: обрезка по границе буквы */
#if LINK_SW_WIRE
  for (uint8_t i = 0; i < NEURONS; i++) {
    NeuroBus.beginTransmission((uint8_t)(I2C_BASE_ADDR + i));
    NeuroBus.write((const uint8_t *)b, (uint8_t)strlen(b));
    NeuroBus.endTransmission();
  }
#else
  NeuroSer.print(b); NeuroSer.print('\n');
#endif
}

/* Новая функция из реестра облака -> платам-нейронам: "SKIL;<имя>" (v1.4).
 * Нейрон отвечает двойной вспышкой LED и всплеском активации — сеть
 * «отмечает» появление новой функции мозга.                            */
void broadcastSkill() {
  txtBump(12);                         // новая функция — заметное текст-событие
  char b[30];
  snprintf(b, sizeof(b), "SKIL;%.20s", skill_out);
  utf8Fix(b);                          /* v2.24: обрезка по границе буквы */
#if LINK_SW_WIRE
  for (uint8_t i = 0; i < NEURONS; i++) {
    NeuroBus.beginTransmission((uint8_t)(I2C_BASE_ADDR + i));
    NeuroBus.write((const uint8_t *)b, (uint8_t)strlen(b));
    NeuroBus.endTransmission();
  }
#else
  NeuroSer.print(b); NeuroSer.print('\n');
#endif
}

/* v2.24: счётчик МУСОРНЫХ ответов с шины нейронов (шум на длинных
 * проводах): растёт на каждом битом пакете, обнуляется хорошим.
 * Показывается в [NET] как «шум шины», всплеск чинит шину (pollNext). */
uint32_t busBad = 0;

int8_t idSeen[NEURONS];           /* v2.26: какой № сообщал слот (лог при смене) */

#if LINK_SW_WIRE
/* v2.23: живость нейрона — сбрасываем только после НЕСКОЛЬКИХ пустых
 * опросов подряд: одиночный сбой шины не гасит нейрон в карте NET и не
 * отправляет его в DEAD_SKIP-пропуск. */
#define MISS_DEAD      3
void pollNeuronWire(uint8_t idx) {
  NeuroBus.requestFrom((uint8_t)(I2C_BASE_ADDR + idx), (uint8_t)32);
  char buf[33]; uint8_t n = 0;
  while (NeuroBus.available() && n < 32) buf[n++] = (char)NeuroBus.read();
  buf[n] = 0;
  if (n == 0) {
    /* v2.23: РЕТРАЙ — одиночная помеха на длинных проводах не должна
     * объявлять нейрон мёртвым */
    NeuroBus.requestFrom((uint8_t)(I2C_BASE_ADDR + idx), (uint8_t)32);
    while (NeuroBus.available() && n < 32) buf[n++] = (char)NeuroBus.read();
    buf[n] = 0;
    if (n == 0) {
      if (ns[idx].miss < 255) ns[idx].miss++;
      if (ns[idx].miss >= MISS_DEAD) ns[idx].alive = false;
      return;
    }
  }
  ns[idx].miss = 0;
  /* v2.24: ЖЁСТКАЯ ПРОВЕРКА ПАКЕТА (формат N<id>;<спайки>;<слово>).
   * Раньше слово уходило в мозг и мост КАК ЕСТЬ: битые байты ломали
   * UTF-8, и Python терял события ('utf-8' codec can't decode ...).
   * Мусорный пакет теперь не попадает в нейросеть — только busBad++. */
  char *p1 = strchr(buf, ';');
  char *p2 = p1 ? strchr(p1 + 1, ';') : nullptr;
  if (buf[0] != 'N' || !p1 || !p2) { busBad++; return; }
  *p1 = 0; *p2 = 0;
  bool ok = (p1[1] != 0);
  uint32_t sp = 0;
  for (char *q = p1 + 1; *q; q++) {
    if (*q < '0' || *q > '9') { ok = false; break; }
    sp = sp * 10 + (uint32_t)(*q - '0');
  }
  if (!ok) { busBad++; return; }          // спайки не число — мусор
  char clean[TEXT_MAX + 1];
  strlcpy(clean, p2 + 1, sizeof(clean));  // <= TEXT_MAX байт: обрыв хвоста
  sanitize(clean);
  utf8Fix(clean);                         // v2.24: битая буква -> пробел
  busBad = 0;                             // хороший пакет — шум кончился
  /* v2.26: ЧЕСТНЫЕ АДРЕСА: верим номеру, который нейрон сообщает сам.
   * Раньше данные писались в слот ОПРАШИВАЕМОГО адреса — нейрон,
   * сбросившийся на другой адрес/номер («пишет 1 вместо 2»), терял
   * спайки и слова («их только два»). Код нейронов НЕ меняется. */
  uint8_t real = idx;
  if (p1 > buf + 1) {
    long rid = 0; bool okId = true;
    for (char *q = buf + 1; q < p1; q++) {
      if (*q < '0' || *q > '9') { okId = false; break; }
      rid = rid * 10 + (*q - '0');
    }
    if (okId && rid >= 0 && rid < NEURONS) real = (uint8_t)rid;
  }
  if (real != idx && idSeen[idx] != (int8_t)real) {
    idSeen[idx] = (int8_t)real;
    HUB_OUT.print("[NET] нейрон сообщает №");
    HUB_OUT.print((unsigned)real);
    HUB_OUT.print(" с адреса 0x");
    HUB_OUT.print(I2C_BASE_ADDR + idx, HEX);
    HUB_OUT.print(" (слот №");
    HUB_OUT.print((unsigned)idx);
    HUB_OUT.println(") — данные идут по его слову");
  }
  ns[idx].alive = true;                   // АДРЕС отвечает (карта NET)
  notePacket(real, sp, clean);            // спайки/слово — по слову нейрона
  appendValC(real, sp, clean);
}

/* v2.23: ВОССТАНОВЛЕНИЕ ЗАВИСШЕЙ ШИНЫ I2C. Классическая беда: после помехи
 * или сброса нейрона ведомый держит SDA прижатой к земле — мастер читает
 * «занято», и ВСЕ нейроны после этого молчат (вживую выглядит как
 * «работают только два»). Лечение по спецификации I2C: 9 тактов SCL при
 * отпущенной SDA, затем STOP. Зовётся при старте и из pollNext, когда
 * молчат ВСЕ нейроны (не чаще раза в минуту). Обычные пины D2/D3. */
void i2cBusRecover() {
  pinMode(BUS_SDA, INPUT_PULLUP);
  pinMode(BUS_SCL, OUTPUT);
  digitalWrite(BUS_SCL, HIGH);
  for (uint8_t i = 0; i < 9 && digitalRead(BUS_SDA) == LOW; i++) {
    digitalWrite(BUS_SCL, LOW);
    delayMicroseconds(20);
    digitalWrite(BUS_SCL, HIGH);
    delayMicroseconds(20);
  }
  digitalWrite(BUS_SCL, LOW);          // STOP: SCL=0 -> SDA=0 -> отпустить
  pinMode(BUS_SDA, OUTPUT);
  digitalWrite(BUS_SDA, LOW);
  delayMicroseconds(20);
  pinMode(BUS_SDA, INPUT_PULLUP);      // SDA отпущена — шина свободна
  digitalWrite(BUS_SCL, HIGH);
  delayMicroseconds(20);
  digitalWrite(BUS_SCL, LOW);
  NeuroBus.begin();                    // переинициализация SoftwareWire
}
#else
void setMux(uint8_t ch) {
  for (uint8_t b = 0; b < 4; b++)
    digitalWrite(MUX_PINS[b], (ch >> b) & 1 ? HIGH : LOW);
}
void pollNeuronSer(uint8_t idx) {
  setMux(idx);
  while (NeuroSer.available()) NeuroSer.read();  // чистим приёмник
  NeuroSer.print("POLL\n");
  /* v2.18: ожидание 30 -> 15 мс — живой нейрон отвечает за 1-5 мс,
   * а молчащий перестал тормозить loop вдвое дольше нужного */
  uint32_t t0 = millis(); char buf[40]; uint8_t n = 0;
  while (millis() - t0 < 15) {
    while (NeuroSer.available() && n < 39) {
      char c = (char)NeuroSer.read();
      if (c == '\n') { buf[n] = 0; goto got; }
      buf[n++] = c;
    }
  }
  buf[n] = 0; if (n == 0) { ns[idx].alive = false; return; }
got:
  /* v2.24: та же жёсткая проверка, что и в pollNeuronWire */
  char *p1 = strchr(buf, ';');
  char *p2 = p1 ? strchr(p1 + 1, ';') : nullptr;
  if (buf[0] != 'N' || !p1 || !p2) { busBad++; return; }
  *p1 = 0; *p2 = 0;
  bool ok = (p1[1] != 0);
  uint32_t sp = 0;
  for (char *q = p1 + 1; *q; q++) {
    if (*q < '0' || *q > '9') { ok = false; break; }
    sp = sp * 10 + (uint32_t)(*q - '0');
  }
  if (!ok) { busBad++; return; }
  char clean[TEXT_MAX + 1];
  strlcpy(clean, p2 + 1, sizeof(clean));
  sanitize(clean);
  utf8Fix(clean);                         // v2.24: мост не падает на UTF-8
  busBad = 0;
  /* v2.26: честные адреса — как в pollNeuronWire (верим слову нейрона) */
  uint8_t real = idx;
  if (p1 > buf + 1) {
    long rid = 0; bool okId = true;
    for (char *q = buf + 1; q < p1; q++) {
      if (*q < '0' || *q > '9') { okId = false; break; }
      rid = rid * 10 + (*q - '0');
    }
    if (okId && rid >= 0 && rid < NEURONS) real = (uint8_t)rid;
  }
  if (real != idx && idSeen[idx] != (int8_t)real) {
    idSeen[idx] = (int8_t)real;
    HUB_OUT.print("[NET] нейрон сообщает №");
    HUB_OUT.print((unsigned)real);
    HUB_OUT.print(" с адреса 0x");
    HUB_OUT.print(I2C_BASE_ADDR + idx, HEX);
    HUB_OUT.print(" (слот №");
    HUB_OUT.print((unsigned)idx);
    HUB_OUT.println(") — данные идут по его слову");
  }
  ns[idx].alive = true;                   // АДРЕС отвечает (карта NET)
  notePacket(real, sp, clean);
  appendValC(real, sp, clean);
}
#endif

/* v2.18: МЕРТВЫЕ НЕЙРОНЫ ОПРАШИВАЕМ РЕДКО. Пока скетч ждёт ответа молчащей
 * платы (а с SoftwareWire — тем более), loop стоит и мост голодает. Живые
 * опрашиваются каждый круг, молчащие — раз в DEAD_SKIP кругов. */
#define DEAD_SKIP      8

uint8_t  allMiss = 0;             // v2.23: сколько подряд опросов молчат ВСЕ
uint32_t lastRecover = 0;         // v2.23: когда последний раз чинили шину

void pollNext() {
  if (millis() - tPoll < POLL_MS) return;
  tPoll = millis();
  /* v2.18: пропуск молчащих — loop не блокируется на пустом адресе */
  for (uint8_t tries = 0; tries < NEURONS; tries++) {
    if (ns[pollIdx].alive || ((cycle + pollIdx) % DEAD_SKIP) == 0) break;
    pollIdx = (pollIdx + 1) % NEURONS;
    /* ФИКС «1/12»: круг завершается и тогда, когда переход через 0
     * случился при ПРОПУСКЕ молчащих. Раньше cycle++ был только после
     * опроса №11 — пока он молчал, cycle замирал, и молчащие слоты
     * (при старте — все) больше никогда не опрашивались: вечно
     * проверялись лишь адреса 0x10 и 0x18. */
    if (pollIdx == 0) cycle++;
  }
#if LINK_SW_WIRE
  pollNeuronWire(pollIdx);
#else
  pollNeuronSer(pollIdx);
#endif
  pollIdx = (pollIdx + 1) % NEURONS;
  if (pollIdx == 0) {          // завершён круг по всем 12 нейронам
    cycle++;
    if (strlen(val_c) == 0) strlcpy(val_c, "silence", VAL_C_SIZE);
  }
#if LINK_SW_WIRE
  /* v2.23: молчат ВСЕ нейроны подряд — шина зависла, чиним (не чаще
   * раза в минуту; после помехи нейроны возвращаются БЕЗ перезагрузки) */
  bool anyAlive = false;
  for (uint8_t i = 0; i < NEURONS; i++) if (ns[i].alive) anyAlive = true;
  if (!anyAlive) {
    if (allMiss < 255) allMiss++;
    if (allMiss >= 100 && millis() - lastRecover > 60000UL) {
      lastRecover = millis();
      allMiss = 0;
      HUB_OUT.println("[NET] вся шина молчит — восстановление I2C (9 тактов SCL)");
      i2cBusRecover();
    }
  } else {
    allMiss = 0;
  }
  /* v2.24: ШУМ, а не тишина — всплеск мусорных ответов тоже чинит шину.
   * Раньше при паре живых нейронов зависание шины на остальных никак
   * не лечилось (allMiss не рос). busBad >= 40 подряд (не сбрасываясь
   * хорошим пакетом) — явная помеха/зависание: 9 тактов SCL + STOP. */
  if (busBad >= 40 && millis() - lastRecover > 60000UL) {
    lastRecover = millis();
    HUB_OUT.print("[NET] мусорные ответы с шины (");
    HUB_OUT.print((unsigned long)busBad);
    HUB_OUT.println(") — восстановление I2C (9 тактов SCL)");
    i2cBusRecover();
    busBad = 0;
  }
#endif
}

/* ----------------------------- АНАЛИЗ val_c ------------------------------ */
/* Анализ + печать в total_val_c. Формат:
 * TS=..;SPK=..;ACT=..;TOP=..;TOK=..;HSH=..;CYC=..;GEN=..;CAM=..;MIC=..;
 * TXT=..;VB=..;CLD=..;SKL=..;MSG=...                                       */
void analyzeAndPrint() {
  if (millis() - tAnalyze < ANALYZE_MS) return;
  tAnalyze = millis();

  uint32_t spkSum = 0; uint8_t active = 0; int8_t top = -1; uint32_t topSpk = 0;
  uint16_t tokens = 0;
  /* v2.26: активность/топ/слова — по ДАННЫМ (кто реально прислал спайки,
   * пусть даже с «чужого» адреса); карта NET отдельно показывает адреса */
  for (uint8_t i = 0; i < NEURONS; i++) {
    if (ns[i].spikes > 0) {
      active++;
      if (strlen(ns[i].word) > 0) tokens++;
      if (ns[i].spikes > topSpk) { topSpk = ns[i].spikes; top = i; }
    }
    spkSum += ns[i].spikes;
  }

  char msg[240] = "";
  for (uint8_t i = 0; i < NEURONS && strlen(msg) < 220; i++) {
    if (ns[i].spikes > 0) {
      char it[TEXT_MAX + 20];
      snprintf(it, sizeof(it), "N%u:%lu:%s|", i, (unsigned long)ns[i].spikes, ns[i].word);
      strlcat(msg, it, sizeof(msg));
      ns[i].spikes = 0;                  // окно сброшено — статистика ушла в total_val_c
    }
  }
  if (!msg[0]) strlcpy(msg, "quiet", sizeof(msg));
  utf8Fix(msg);   /* v2.24: слова нейронов чищены при приёме — подстраховка */

  /* v2.11: КАРТА СВЯЗИ С НЕЙРОНАМИ — кто отвечал на опрос в этом цикле.
   * NET[i]='1' если нейрон №i вернул пакет (ns[i].alive), '0' если молчит.
   * Уходит в total_val_c (NET=), в строку Serial [GEN] и в Bridge.notify
   * on_net — проверка связи видна и в мониторе порта, и в интерфейсе. */
  char netMask[NEURONS + 1];
  for (uint8_t i = 0; i < NEURONS; i++) netMask[i] = ns[i].alive ? '1' : '0';
  netMask[NEURONS] = 0;

  /* ------- СИНТЕЗ ЧАСТОТЫ: камера + микрофон + текст + спайки ------------ */
  uint8_t camLvl = camScore();                       // 0..100: что видит камера
  uint8_t micLvl = micLevel;                         // 0..100: что слышит микрофон
  uint8_t spkLvl = (uint8_t)((uint32_t)(spkSum > 60 ? 60 : spkSum) * 100 / 60);
  txtLevel = (uint8_t)((uint32_t)txtLevel * 95 / 100);   // затухание текст-канала
  uint8_t txtTok = (uint8_t)((uint32_t)tokens * 8 > 100 ? 100 : tokens * 8);
  uint8_t txtLvl = txtLevel > txtTok ? txtLevel : txtTok; // что пишет сам / ему написали

  uint16_t fTarget = cfgMinHz
      + (uint16_t)((uint32_t)cfgCamSpan * camLvl / 100)
      + (uint16_t)((uint32_t)cfgMicSpan * micLvl / 100)
      + (uint16_t)((uint32_t)cfgTxtSpan * txtLvl / 100)
      + (uint16_t)((uint32_t)cfgSpkSpan * spkLvl / 100);
  if (fTarget > cfgMaxHz) fTarget = cfgMaxHz;
  if (fTarget < cfgMinHz) fTarget = cfgMinHz;
  /* v2.67: подтяжка к общему ритму платформы */
  if (syncK && syncHz && (millis() - syncTs) < SYNC_TTL_MS) {
    int32_t d = (int32_t)syncHz - (int32_t)fTarget;
    fTarget = (uint16_t)((int32_t)fTarget + d * (int32_t)syncK / 100);
    if (fTarget > cfgMaxHz) fTarget = cfgMaxHz;
    if (fTarget < cfgMinHz) fTarget = cfgMinHz;
  }
  spkLvlLast = spkLvl;                               // вход нейросети букв

  /* v2.3: ЧАСТОТНЫЙ ТЕГ БУКВЫ — пока активен, на шине точная частота-номер */
  if ((int32_t)(pulseUntil - millis()) > 0) {
    genHz = pulseHz;
  } else {
    int16_t dHz = (int16_t)fTarget - (int16_t)genHz;
    genHz = (uint16_t)((int16_t)genHz + dHz / 4);      // плавное дыхание частоты
    if (dHz >= GEN_DEADBAND || -dHz >= GEN_DEADBAND)
      broadcastGen();                                  // темп пластики нейронам (резерв)
  }

  /* ---- МОТИВАЦИЯ ГОВОРИТЬ (v1.9): мозг «хочет говорить» ---------------- */
  /* Если текст-канал или спайки высоки и давно не говорил — короткий
   * сигнал готовности. Динамик -> микрофон -> частота: петля самостимуляции,
   * ограниченная VOICE_IDLE_MS и анти-заводкой в voiceSay().              */
  if (!voxSteps && (millis() - lastPhraseMs > VOICE_IDLE_MS) &&
      (txtLvl >= VOICE_READY || spkLvl >= 80))
    voiceSay(genHz, 2);

  snprintf(total_val_c, TOTAL_SIZE,
           "TS=%lu;SPK=%lu;ACT=%u;TOP=%d;TOK=%u;HSH=%06lX;CYC=%lu;GEN=%u;CAM=%u;MIC=%u;TXT=%u;VOX=%u;TCH=%u;LTR=%u;CHR=%s;WRD=%.22s;SAY=%.48s;VB=%.90s;CLD=%.40s;SKL=%.12s;NET=%s;MSG=%s",
           (unsigned long)millis(), (unsigned long)spkSum, active, (int)top,
           tokens, (unsigned long)(fnv1a(val_c) & 0xFFFFFF),
           (unsigned long)cycle, (unsigned)genHz,
           (unsigned)camLvl, (unsigned)micLvl, (unsigned)txtLvl,
           (unsigned)voxCount, (unsigned)teachCount, (unsigned)curLetterNum,
           curChr, genWord, sayBuf, val_b, cloud_buf, skill_out, netMask, msg);
  utf8Fix(total_val_c);   /* v2.24: %.Ns-обрезки не рвут букву UTF-8 */

  /* v2.3: информация о частоте ВСЕГДА видна в Serial (и в GEN= total_val_c,
   * и в коротком ключе gen_hz моста — потеряться больше не может).
   * v2.19: буквы (LTR/CHR) и слова (WRD) из печати УБРАНЫ — человек не
   * видит «мысли» генератора; осталась частота и готовая фраза SAY. */
  HUB_OUT.print("[GEN] "); HUB_OUT.print((unsigned)genHz); HUB_OUT.print(" Hz");
  HUB_OUT.print(" | SAY=\""); HUB_OUT.print(sayBuf); HUB_OUT.print("\"");
  /* v2.11: карта связи — сразу видно в мониторе порта, кто не отвечает */
  HUB_OUT.print(" | NET="); HUB_OUT.print(netMask);
  HUB_OUT.print(" (");
  uint8_t netOk = 0; for (uint8_t i = 0; i < NEURONS; i++) if (ns[i].alive) netOk++;
  HUB_OUT.print((unsigned)netOk); HUB_OUT.print("/"); HUB_OUT.print((unsigned)NEURONS);
  HUB_OUT.print(" отвечают");
#if LINK_SW_WIRE
  if (busBad) {
    HUB_OUT.print(", шум шины: "); HUB_OUT.print((unsigned long)busBad);
  }
#endif
  HUB_OUT.println(")");
#if USE_RB
  /* v2.87: все строки в мост — только после utf8Fix, иначе
   * Bridge.read_loop падает на 0x93/0x91/0xa6 */
  utf8Fix(curChr);
  utf8Fix(genWord);
  utf8Fix(sayBuf);
  Bridge.notify("on_state", (int)genHz, (int)curLetterNum, String(curChr),
                String(genWord), String(sayBuf), (int)spkSum, (int)active,
                (int)top, (int)cycle);
  static char lastNet[NEURONS + 1];       /* v2.11: on_net — при изменении */
  if (strncmp(netMask, lastNet, sizeof(lastNet)) != 0) {
    strncpy(lastNet, netMask, sizeof(lastNet) - 1); lastNet[sizeof(lastNet) - 1] = 0;
    utf8Fix(lastNet);
    Bridge.notify("on_net", String(lastNet));
  }
  static char lastMsg[240];                 /* on_msg — только при изменении */
  if (strncmp(msg, lastMsg, sizeof(lastMsg)) != 0) {
    strncpy(lastMsg, msg, sizeof(lastMsg) - 1); lastMsg[sizeof(lastMsg) - 1] = 0;
    utf8Fix(lastMsg);
    Bridge.notify("on_msg", String(lastMsg));
  }
#endif
}

/* ----------------------------- СВЯЗЬ С LINUX-СТОРОНОЙ -------------------- */
void broadcastStim(const char *text) {
  txtBump(35);                         // мозг пишет сам / ему написали — текст жив
  voiceSay(genHz, 3);                  // МОТИВАЦИЯ ГОВОРИТЬ: мозг «собирается с мыслями»
  char clean[CHAT_OUT_SIZE];
  strlcpy(clean, text, CHAT_OUT_SIZE);
  sanitize(clean);                       // чистим ТОЛЬКО текст стимула
  char stim[CHAT_OUT_SIZE + 8];
  snprintf(stim, sizeof(stim), "STIM;%s", clean);   // иначе нейрон не узнает "STIM;"
  utf8Fix(stim);                       /* v2.24: в мост/нейронам — целый UTF-8 */
#if LINK_SW_WIRE
  for (uint8_t i = 0; i < NEURONS; i++) {
    NeuroBus.beginTransmission((uint8_t)(I2C_BASE_ADDR + i));
    NeuroBus.write((const uint8_t *)stim, (uint8_t)min((size_t)31, strlen(stim)));
    NeuroBus.endTransmission();
  }
#else
  NeuroSer.print(stim); NeuroSer.print('\n');
#endif
}

