/* Генератор D4 (объявлено рано: нужно кадру D4 ниже) */
uint16_t genHz = GEN_MIN_HZ;          // ТЕКУЩАЯ частота на пине D4, Гц
bool     genOut = false;              // текущий уровень на D4
uint32_t nextEdgeUs = 0;              // время следующего фронта (догоняющий планировщик)

/* v2.49: ЧИСТЫЙ КАДР НА D6 (режим облака d6_cammode = "pure"): без PWM-уровней
 * и без байтов. Пин переводится в обычный цифровой выход (digitalWrite), а
 * кадр 32x24 чёрно-белых точек (серое — упорядоченный дизеринг на стороне
 * Python) «рисуется» самим уровнем сигнала, как факсимильная развёртка:
 * одна точка = один Манчестер-слот D6P_HALF_US*2: белая = ВЫСОКИЙ->НИЗКИЙ,
 * чёрная = НИЗКИЙ->ВЫСОКИЙ. В данных подряд бывает не более 2 половинок
 * одного уровня, поэтому служебные сигналы отличимы длиной уровня:
 *   начало кадра (слитно со строкой 0): НИЗ x2, ВЫСОКИЙ x6, НИЗ x2;
 *   начало строки: ВЫСОКИЙ x3, НИЗ x2, затем 32 точки (срез после x3 — отсчёт);
 *   отличить кадр от строки приёмник может независимо от такта: отношение
 *   длины ВЫСОКОГО к следующему НИЗКОМУ >= 2 (6:2) — кадр, иначе (3:2 или 3:3)
 *   — строка;
 *   конец кадра: НИЗ.
 * Кадр идёт строками: между строками loop() свободен. ВАЖНО: пока идёт ОДНА
 * строка (~70 мс), loop() занят отсчётом микросекунд (D4 при этом
 * поддерживается вызовом freqTick()). Один кадр ~1,7 с (против ~41 с PWM).
 * Согласование с мыслью: «плюс» — кадр запаздывает за мыслью на pi/2 (одна
 * четверть цикла из 4 слотов D6_STEP_MS; играется ПОСЛЕ мысли с паузой
 * D6_STEP_MS; мысль, пришедшая во время кадра, кадр прерывает); «минус» —
 * кадр опережает мысль на pi/2 (мысль, пришедшая во время кадра, ждёт его
 * конца + D6_STEP_MS). Пока не проверено на железе UNO Q: после analogWrite()
 * digitalWrite() должен вернуть пин в обычный выход — если ядро этого не
 * делает, нужен pinMode(NN_OUT_PIN, OUTPUT) перед кадром (он есть). */
#define D6P_W        32
#define D6P_H        24
#define D6P_N        (D6P_W * D6P_H)
#define D6P_HALF_US  1000UL
uint8_t  d6pIn[D6P_N];                  // принимаемый кадр: 0/1 на точку
uint8_t  d6pBuf[D6P_N];                 // играемый кадр
bool     d6pInNeg = false, d6pRdy = false;
bool     d6pNeg = false, d6pRun = false;
int16_t  d6pRow = 0;                    // строка 0..H-1 (в строке 0 — ещё и заголовок кадра)
uint32_t d6pNextMs = 0, d6IdleSince = 0, d6pGapUntil = 0;

static inline void d6pSlot(uint8_t lvl, uint32_t &t) {
  digitalWrite(NN_OUT_PIN, lvl ? HIGH : LOW);
  t += D6P_HALF_US;
  while ((int32_t)(micros() - t) < 0) freqTick();   // D4 не стоит
}

void d6pEmit(int16_t row) {
  uint32_t t = micros();
  if (row == 0) {                                   // начало кадра + строка 0 слитно
    d6pSlot(0, t); d6pSlot(0, t);
    for (uint8_t i = 0; i < 6; i++) d6pSlot(1, t);
    d6pSlot(0, t); d6pSlot(0, t);
  }
  for (uint8_t i = 0; i < 3; i++) d6pSlot(1, t);    // начало строки
  d6pSlot(0, t); d6pSlot(0, t);
  for (uint8_t x = 0; x < D6P_W; x++) {
    uint8_t b = d6pBuf[row * D6P_W + x];
    d6pSlot(b ? 1 : 0, t);                          // белая: ВЫСОКИЙ -> НИЗКИЙ
    d6pSlot(b ? 0 : 1, t);                          // чёрная: НИЗКИЙ -> ВЫСОКИЙ
  }
  d6pSlot(0, t);
}

/* v2.50/v2.51: ЧИСТЫЙ КАДР НА D4 (опция облака d4_camframe) — тот же метод,
 * что на D6 (Манчестер: белая ВЫСОКИЙ->НИЗКИЙ, чёрная НИЗКИЙ->ВЫСОКИЙ), но
 * ТАКТ кадра — ЗНАКОВАЯ ЧАСТОТА «ДЫХАНИЯ», которую задаёт внутренняя тензорная
 * сеть платы (Python: профиль из 24 частот, по одной на строку, в пределах
 * -2000..+2000 Гц; ни LLM, ни нейроны её не выбирают). Половина слота
 * = 1/(2*|f|), |f| не ниже D4F_MIN_HZ (200 Гц) и не выше D4F_MAX_HZ (2000 Гц).
 * ЗНАК частоты — КОД СТРОКИ: f < 0 -> после синхро ВЫСОКИЙ x5 идёт НИЗКИЙ x4
 * (у f > 0 — НИЗКИЙ x2) и точки кодируются наоборот (белая НИЗКИЙ->ВЫСОКИЙ).
 * Уровни не инвертируются, поэтому перепад знака между строками не склеивается
 * с паузой между строками. Реальная частота ведётся к целевой профиля не
 * быстрее ±25 % за строку; перед сменой знака |f| спускается до D4F_MIN_HZ
 * («пауза между вдохом и выдохом»).
 * Приёмник ведёт такт по синхро строки: ВЫСОКИЙ x5 в 4.0..6.7 прежних
 * половинок — синхро (данные не длиннее 2 половинок, т.е. до 2.7); следующий
 * НИЗКИЙ <3.5 половинок — «+», иначе «-» (данные после синхро могут добавить
 * к НИЗКОМУ x2 ещё одну половинку: 2..3 против 4..5).
 * Заголовок кадра слит со строкой 0: НИЗ x2, ВЫСОКИЙ x10, НИЗ x2 (отношение
 * к следующему НИЗКОМУ = 5, у синхро строки 2.5 или 1.25).
 * Пока идёт кадр, меандр генератора на D4 не выводится (freqTick молчит):
 * нейроны считают фронты и ~2 с видят частоту, зависящую от картинки; частые
 * кадры = заметное искажение темпа нейронов (так просил владелец). */
#define D4F_MIN_HZ 200
#define D4F_MAX_HZ 2000
uint8_t  d4fIn[D6P_N];
uint8_t  d4fBuf[D6P_N];
int16_t  d4fProf[D6P_H];                // целевая знаковая частота по строкам, Гц
bool     d4fProfOn = false;             // профиль задан (иначе: |genHz|, знак d4Pol)
bool     d4fRdy = false, d4fRun = false;
int16_t  d4fRow = 0;
uint32_t d4fNextMs = 0;
int16_t  d4fCur = 0;                    // текущая знаковая частота строки
uint16_t d4fLastHz = 0;                 // |f| последней строки (для статуса)
int8_t   d4fLastSign = 1;

static inline void d4fSlot(uint8_t lvl, uint32_t &t, uint32_t half) {
  digitalWrite(GEN_PIN, lvl ? HIGH : LOW);
  t += half;
  while ((int32_t)(micros() - t) < 0) { }
}

/* следующая знаковая частота: к цели не быстрее ±25 % за строку, смена знака
 * через D4F_MIN_HZ */
int16_t d4fStep(int16_t cur, int16_t target) {
  int16_t tg = target;
  if (tg > D4F_MAX_HZ) tg = D4F_MAX_HZ;
  if (tg < -D4F_MAX_HZ) tg = -D4F_MAX_HZ;
  int16_t sc = cur < 0 ? -1 : 1, st = tg < 0 ? -1 : 1;
  int32_t mc = cur < 0 ? -cur : cur, mt = tg < 0 ? -tg : tg;
  if (mt < D4F_MIN_HZ) mt = D4F_MIN_HZ;
  if (mc < D4F_MIN_HZ) mc = D4F_MIN_HZ;
  if (sc != st) {                       // сначала вниз до минимума, потом знак
    if (mc <= D4F_MIN_HZ) return (int16_t)(st * D4F_MIN_HZ);
    mt = D4F_MIN_HZ; st = sc;
  }
  int32_t hi = mc * 125 / 100, lo = mc * 75 / 100;
  int32_t m = mt > hi ? hi : (mt < lo ? lo : mt);
  if (m < D4F_MIN_HZ) m = D4F_MIN_HZ;
  if (m > D4F_MAX_HZ) m = D4F_MAX_HZ;
  return (int16_t)(st * m);
}

void d4fEmit(int16_t row) {
  int16_t f;
  if (d4fProfOn) {
    f = (row == 0) ? d4fStep(d4fProf[0] < 0 ? -D4F_MIN_HZ : D4F_MIN_HZ, d4fProf[0])
                   : d4fStep(d4fCur, d4fProf[row]);
    if (row == 0) {                     // первая строка: прямо к цели (не быстрее 25 %)
      int16_t m0 = d4fProf[0] < 0 ? -d4fProf[0] : d4fProf[0];
      if (m0 < D4F_MIN_HZ) m0 = D4F_MIN_HZ;
      if (m0 > D4F_MAX_HZ) m0 = D4F_MAX_HZ;
      f = (int16_t)((d4fProf[0] < 0 ? -1 : 1) * m0);
    }
  } else {                              // без профиля: |genHz|, знак по d4Pol
    uint16_t g = genHz < D4F_MIN_HZ ? D4F_MIN_HZ : (genHz > D4F_MAX_HZ ? D4F_MAX_HZ : genHz);
    int16_t tg = (int16_t)(d4Pol < 0 ? -(int16_t)g : (int16_t)g);
    f = (row == 0) ? tg : d4fStep(d4fCur, tg);
  }
  d4fCur = f;
  bool inv = f < 0;
  uint16_t hz = (uint16_t)(f < 0 ? -f : f);
  uint32_t half = 500000UL / hz;
  d4fLastHz = hz; d4fLastSign = inv ? -1 : 1;
  uint32_t t = micros();
  if (row == 0) {                       // начало кадра + строка 0 слитно
    d4fSlot(0, t, half); d4fSlot(0, t, half);
    for (uint8_t i = 0; i < 10; i++) d4fSlot(1, t, half);
    d4fSlot(0, t, half); d4fSlot(0, t, half);
  }
  for (uint8_t i = 0; i < 5; i++) d4fSlot(1, t, half);        // синхро строки
  for (uint8_t i = 0; i < (inv ? 4 : 2); i++) d4fSlot(0, t, half);   // знак
  for (uint8_t x = 0; x < D6P_W; x++) {
    uint8_t b = d4fBuf[row * D6P_W + x];
    if (inv) b = !b;                    // «минус»: код точек наоборот
    d4fSlot(b ? 1 : 0, t, half);
    d4fSlot(b ? 0 : 1, t, half);
  }
  d4fSlot(0, t, half);
}

void d4fTick() {
  if (!d4fRun) {
    if (d4fRdy) {
      memcpy(d4fBuf, d4fIn, D6P_N);
      d4fRdy = false;
      pinMode(GEN_PIN, OUTPUT);
      d4fRun = true; d4fRow = 0; d4fNextMs = 0;
    }
    return;
  }
  if ((int32_t)(millis() - d4fNextMs) < 0) return;
  d4fEmit(d4fRow);
  d4fRow++;
  d4fNextMs = millis() + 3;
  if (d4fRow >= D6P_H) {
    d4fRun = false; d4fRow = 0;
    digitalWrite(GEN_PIN, genOut ? HIGH : LOW);   // меандр генератора возвращается
    nextEdgeUs = micros();
  }
}

/* true — пока чистый кадр владеет пином (идёт кадр или держится пауза «−pi/2») */
bool d6PureTick(bool thoughtBusy) {
  uint32_t now = millis();
  if (thoughtBusy) d6IdleSince = now;
  if (d6pRun) {
    if ((int32_t)(now - d6pNextMs) < 0) return true;
    d6pEmit(d6pRow);
    d6pRow++;
    d6pNextMs = millis() + 3;
    if (d6pRow >= D6P_H) {
      digitalWrite(NN_OUT_PIN, LOW);
      d6pRun = false; d6pRow = 0;
      d6IdleSince = millis();
      if (d6pNeg) d6pGapUntil = millis() + D6_STEP_MS;   // мысль после кадра
    }
    return true;
  }
  if (d6pGapUntil && (int32_t)(now - d6pGapUntil) < 0) return true;
  d6pGapUntil = 0;
  if (d6pRdy && !thoughtBusy && (int32_t)(now - d6IdleSince) >= (int32_t)D6_STEP_MS) {
    memcpy(d6pBuf, d6pIn, D6P_N);
    d6pNeg = d6pInNeg; d6pRdy = false;
    pinMode(NN_OUT_PIN, OUTPUT);                    // PWM снят: обычный выход
    d6pRun = true; d6pRow = 0; d6pNextMs = 0;
  }
  return false;
}

void d6PutText(const char *txt) {
  if (!txt || !txt[0]) return;
  if (d6pRun && !d6pNeg) {              // v2.49: «плюс» — мысль главнее кадра
    d6pRun = false; d6pRow = 0; digitalWrite(NN_OUT_PIN, LOW);
  }
  strlcpy(d6Txt, txt, sizeof(d6Txt));   // новая посылка вытесняет старую
  d6Len = (uint16_t)strlen(d6Txt);
  d6Pos = 0; d6NextMs = 0;              // начать немедленно
  d6FrPos = 4;                          // идущий кадр прерван новой фразой
}

