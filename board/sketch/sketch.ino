/* Запасной протокол (без Arduino_Bridge), hex-кодирование:
 *   GETK <key>            -> VALK <key> <hex> | VALK <key> -
 *   PUTK <key> <hex>      -> OKK              (val_b / chat_out / cloud_buf / skill_out)
 *   PING                  -> PONG <millis>                                   */
void hexDecode(const char *hex, char *out, uint16_t maxOut) {
  uint16_t o = 0;
  for (uint16_t i = 0; hex[i] && hex[i + 1] && o < maxOut - 1; i += 2) {
    char b[3] = {hex[i], hex[i + 1], 0};
    out[o++] = (char)strtol(b, nullptr, 16);
  }
  out[o] = 0;
}
void serialProto() {
  static char line[1100]; static uint16_t ln = 0;
  while (HUB_OUT.available()) {
    char c = (char)HUB_OUT.read();
    if (c == '\n') { line[ln] = 0; break; }
    if (c != '\r' && ln < sizeof(line) - 1) line[ln++] = c;
    return;                              // строка ещё не собрана
  }
  if (ln == 0 || line[ln] != 0) return;
  ln = 0;

  if (!strncmp(line, "PING", 4)) { HUB_OUT.print("PONG "); HUB_OUT.println(millis()); return; }
  if (!strncmp(line, "GETK ", 5)) {
    const char *key = line + 5;
    if (!strcmp(key, "gen_hz") || !strcmp(key, "ltr")) {   // v2.3: короткие ключи
      HUB_OUT.print("VALK "); HUB_OUT.print(key); HUB_OUT.print(' ');
      if (!strcmp(key, "gen_hz")) HUB_OUT.print((unsigned)genHz);
      else HUB_OUT.print((unsigned)curLetterNum);
      HUB_OUT.println();
      return;
    }
    const char *src = (!strcmp(key, "total_val_c")) ? total_val_c
                    : (!strcmp(key, "val_c"))       ? val_c
                    : (!strcmp(key, "say"))         ? sayBuf : "";
    if (!src[0] && !strcmp(key, "total_val_c")) src = "";
    HUB_OUT.print("VALK "); HUB_OUT.print(key); HUB_OUT.print(' ');
    for (const char *p = src; *p; p++) HUB_OUT.print((uint8_t)*p < 16 ? "0" : ""), HUB_OUT.print((uint8_t)*p, HEX);
    if (!src[0]) HUB_OUT.print("-");
    HUB_OUT.println();
    return;
  }
  if (!strncmp(line, "PUTK ", 5)) {
    char key[24]; uint16_t k = 0; const char *p = line + 5;
    while (*p && *p != ' ' && k < 23) key[k++] = *p++;
    key[k] = 0; if (*p == ' ') p++;
    char dec[VAL_B_SIZE]; hexDecode(p, dec, sizeof(dec));
    if      (!strcmp(key, "val_b"))    { strlcpy(val_b, dec, VAL_B_SIZE);    sanitize(val_b); }
    else if (!strcmp(key, "chat_out")) { strlcpy(chat_out, dec, CHAT_OUT_SIZE); sanitize(chat_out); broadcastStim(chat_out); }
    else if (!strcmp(key, "cloud_buf")) {
      if (strlen(dec) && strcmp(dec, cloud_buf) != 0) {
        strlcpy(cloud_buf, dec, CLOUD_BUF_SIZE); sanitize(cloud_buf);
        broadcastBuf();                // сводка облака -> нейронам
      }
    }
    else if (!strcmp(key, "skill_out")) {
      if (strlen(dec) && strcmp(dec, skill_out) != 0) {
        strlcpy(skill_out, dec, SKILL_OUT_SIZE); sanitize(skill_out);
        broadcastSkill();              // новая функция мозга -> нейронам
      }
    }
    else if (!strcmp(key, "voice")) {  // v1.9: вкл/выкл голоса
      if (dec[0] == '0') voiceOn = false;
      else if (dec[0] == '1') voiceOn = true;
    }
    else if (!strcmp(key, "speak")) {  // v1.9: озвучить мысль/реплику
      if (dec[0] == '1' && !dec[1]) voiceSay(genHz, 4);
      else { int hz = atoi(dec); if (hz > 50) voiceSay((uint16_t)hz, 3); }
    }
    else if (!strcmp(key, "hzcfg")) {  // v2.2: частоты шины из Studio
      if (strlen(dec)) hzcfgApply(dec);
    }
    else if (!strcmp(key, "teach")) {  // v2.3: награда учителя (+1/-1)
      if (dec[0] == '+') netTeach(1);
      else if (dec[0] == '-') netTeach(-1);
    }
    HUB_OUT.println("OKK");
  }
}
void bridgeSync() {
  if (millis() - tBridge < BRIDGE_MS) return;
  tBridge = millis();
  serialProto();
}
