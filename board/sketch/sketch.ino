#include <Arduino.h>

/* ---- STRL-FALLBACK (begin): strlcpy/strlcat для ядра Zephyr (UNO Q) -----
 * Линкер arm-zephyr-eabi не содержит BSD-функций strlcpy/strlcat, а их
 * используют и этот скетч, и библиотека Arduino_RouterBridge (monitor.h).
 * Определяем их как СЛАБЫЕ символы: там, где libc уже даёт свои реализации
 * (AVR/avr-libc 2.x, ESP32/newlib), наши определения линкер просто
 * отбрасывает — конфликта нет. Семантика BSD: возвращают длину src,
 * всегда NUL-завершают dst (при dsize > 0). */
extern "C" __attribute__((weak)) size_t strlcpy(char *dst, const char *src, size_t dsize) {
  size_t slen = strlen(src);
  if (dsize != 0) {
    size_t copy = (slen >= dsize) ? dsize - 1 : slen;
    memcpy(dst, src, copy);
    dst[copy] = '\0';
  }
  return slen;
}
extern "C" __attribute__((weak)) size_t strlcat(char *dst, const char *src, size_t dsize) {
  size_t dlen = 0;
  while (dlen < dsize && dst[dlen] != '\0') dlen++;
  if (dlen == dsize) return dsize + strlen(src);
  size_t slen = strlen(src);
  size_t room = dsize - dlen;
  size_t copy = (slen >= room) ? room - 1 : slen;
  memcpy(dst + dlen, src, copy);
  dst[dlen + copy] = '\0';
  return dlen + slen;
}
/* ---- STRL-FALLBACK (end) ----------------------------------------------- */

